-2-1\">\n                                    </i>\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"lk-record-row\" data-kid=\"1-2-1-2-2-2-5\">\n                            <div class=\"flex min-w-0 items-start gap-3\" data-kid=\"1-2-1-2-2-2-5-1\">\n                                <span class=\"mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#FFF5DE] text-[#A15C00]\" data-kid=\"1-2-1-2-2-2-5-1-1\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-alert-triangle\" data-kid=\"1-2-1-2-2-2-5-1-1-1\" style=\"width:16px;height:16px;font-size:16px;line-height:16px\">\n                                    </i>\n                                </span>\n                                <div class=\"min-w-0\" data-kid=\"1-2-1-2-2-2-5-1-2\">\n                                    <div class=\"lk-status text-[#A15C00]\" data-kid=\"1-2-1-2-2-2-5-1-2-1\">\n                                        <span class=\"lk-status-dot lk-status-dot-amber\" data-kid=\"1-2-1-2-2-2-5-1-2-1-1\">\n                                        </span>\n                                        À suivre aujourd’hui\n                                    </div>\n                                    <div class=\"lk-record-title mt-1\" data-kid=\"1-2-1-2-2-2-5-1-2-2\">\n                                        Rachidi Saka · 150 000 FCFA · retard de 6 jours\n                                    </div>\n                                    <div class=\"lk-record-meta mt-1\" data-kid=\"1-2-1-2-2-2-5-1-2-3\">\n                                        Relance WhatsApp automatique préparée · +229 96 14 77 30\n                                    </div>\n                                </div>\n                            </div>\n                            <button class=\"lk-button lk-button-light h-9 min-h-9 px-3 text-[11px]\" data-kid=\"1-2-1-2-2-2-5-2\" type=\"button\">\n                                Voir l’action\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"1-2-1-2-2-2-5-2-1\" style=\"width:14px;height:14px;font-size:14px;line-height:14px\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n                <aside class=\"lk-hero-rail relative lg:pt-16\" data-kid=\"1-2-1-2-3\">\n                    <div class=\"lk-kicker mb-4\" data-kid=\"1-2-1-2-3-1\">\n                        Aujourd’hui dans votre patrimoine\n                    </div>\n                    <div class=\"lk-metric-slot\" data-kid=\"1-2-1-2-3-2\">\n                        <div class=\"lk-metric-label\" data-kid=\"1-2-1-2-3-2-1\">\n                            Encaissé ce mois\n                        </div>\n                        <div class=\"lk-value lk-mono mt-2\" data-kid=\"1-2-1-2-3-2-2\">\n                            1 450 000\n                        </div>\n                        <div class=\"lk-record-meta mt-1\" data-kid=\"1-2-1-2-3-2-3\">\n                            FCFA · 90% recouvré\n                        </div>\n                    </div>\n                    <div class=\"lk-metric-slot\" data-kid=\"1-2-1-2-3-3\">\n                        <div class=\"lk-metric-label\" data-kid=\"1-2-1-2-3-3-1\">\n                            Reste à recouvrer\n                        </div>\n                        <div class=\"lk-value lk-mono mt-2\" data-kid=\"1-2-1-2-3-3-2\">\n                            350 000\n                        </div>\n                        <div class=\"lk-record-meta mt-1\" data-kid=\"1-2-1-2-3-3-3\">\n                            FCFA · 1 action à traiter\n                        </div>\n                    </div>\n                    <div class=\"lk-metric-slot\" data-kid=\"1-2-1-2-3-4\">\n                        <div class=\"lk-metric-label\" data-kid=\"1-2-1-2-3-4-1\">\n      