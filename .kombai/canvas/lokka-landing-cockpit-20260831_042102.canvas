-2-1-2-6-3\">\n                                    ✓\n                                </td>\n                                <td class=\"px-5 py-4 text-[#087F5B]\" data-kid=\"1-2-8-1-2-1-2-6-4\">\n                                    ✓\n                                </td>\n                            </tr>\n                            <tr class=\"border-b border-[#E4E0D8]\" data-kid=\"1-2-8-1-2-1-2-7\">\n                                <td class=\"px-5 py-4 font-semibold text-[#18181B]\" data-kid=\"1-2-8-1-2-1-2-7-1\">\n                                    Portail locataire\n                                </td>\n                                <td class=\"px-5 py-4 text-[#A1A1AA]\" data-kid=\"1-2-8-1-2-1-2-7-2\">\n                                    —\n                                </td>\n                                <td class=\"px-5 py-4 text-[#087F5B]\" data-kid=\"1-2-8-1-2-1-2-7-3\">\n                                    ✓\n                                </td>\n                                <td class=\"px-5 py-4 text-[#087F5B]\" data-kid=\"1-2-8-1-2-1-2-7-4\">\n                                    ✓\n                                </td>\n                            </tr>\n                            <tr class=\"border-b border-[#E4E0D8]\" data-kid=\"1-2-8-1-2-1-2-8\">\n                                <td class=\"px-5 py-4 font-semibold text-[#18181B]\" data-kid=\"1-2-8-1-2-1-2-8-1\">\n                                    Reversements automatiques aux bailleurs\n                                </td>\n                                <td class=\"px-5 py-4 text-[#A1A1AA]\" data-kid=\"1-2-8-1-2-1-2-8-2\">\n                                    —\n                                </td>\n                                <td class=\"px-5 py-4 text-[#A1A1AA]\" data-kid=\"1-2-8-1-2-1-2-8-3\">\n                                    —\n                                </td>\n                                <td class=\"px-5 py-4 text-[#087F5B]\" data-kid=\"1-2-8-1-2-1-2-8-4\">\n                                    ✓\n                                </td>\n                            </tr>\n                            <tr class=\"border-b border-[#E4E0D8] bg-[#FAF9F6]\" data-kid=\"1-2-8-1-2-1-2-9\">\n                                <th class=\"px-5 py-3 text-[10px] font-semibold uppercase tracking-[.14em] text-[#71717A]\" colspan=\"4\" data-kid=\"1-2-8-1-2-1-2-9-1\">\n                                    Publier & trouver des locataires\n                                </th>\n                            </tr>\n                            <tr class=\"border-b border-[#E4E0D8]\" data-kid=\"1-2-8-1-2-1-2-10\">\n                                <td class=\"px-5 py-4 font-semibold text-[#18181B]\" data-kid=\"1-2-8-1-2-1-2-10-1\">\n                                    Marketplace Lokka (annonces)\n                                </td>\n                                <td class=\"px-5 py-4 text-[#A1A1AA]\" data-kid=\"1-2-8-1-2-1-2-10-2\">\n                                    —\n                                </td>\n                                <td class=\"px-5 py-4 text-[#087F5B]\" data-kid=\"1-2-8-1-2-1-2-10-3\">\n                                    ✓\n                                </td>\n                                <td class=\"px-5 py-4 text-[#087F5B]\" data-kid=\"1-2-8-1-2-1-2-10-4\">\n                                    ✓\n                                </td>\n                            </tr>\n                            <tr class=\"border-b border-[#E4E0D8]\" data-kid=\"1-2-8-1-2-1-2-11\">\n                                <td class=\"px-5 py-4 font-semibold text-[#18181B]\" data-kid=\"1-2-8-1-2-1-2-11-1\">\n                                    Vitrine web (lien standard)\n                                </td>\n                                <td class=\"px-5 py-4 text-[#A1A1AA]\" data-kid=\"1-2-8-1-2-1-2-11-2\">\n                                    —\n                                </td>\n                                <td class=\"px-5 py-4 text-[#087F5B]\" data-kid=\"1-2-8-1-2-1-2-11-3\">\n                                    ✓\n                                </td>\n                                <td class=\"px-5 py-4 text-[#087F5B]\" data-kid=\"1-2-8-1-2-1-2-11-4\">\n                                    ✓\n                                </td>\n                            </tr>\n                            <tr class=\"border-b border-[#E4E0D8]\" data-kid=\"1-2-8-1-2-1-2-12\">\n                                <td class=\"px-5 py-4 font-semibold text-[#18181B]\" data-kid=\"1-2-8-1-2-1-2-12-1\">\n                                    Domaine personnalisé + thèmes\n                                </td>\n                                <td class=\"px-5 py-4 text-[#A1A1AA]\" data-kid=\"1-2-8-1-2-1-2-12-2\">\n                                    —\n                                </td>\n                                <td class=\"px-5 py-4 text-[#A1A1AA]\" data-kid=\"1-2-8-1-2-1-2-12-3\">\n                                    —\n                                </td>\n                                <td class=\"px-5 py-4 text-[#087F5B]\" data-kid=\"1-2-8-1-2-1-2-12-4\">\n                                    ✓\n                                </td>\n                            </tr>\n                            <tr data-kid=\"1-2-8-1-2-1-2-13\">\n                                <td class=\"px-5 py-4 font-semibold text-[#18181B]\" data-kid=\"1-2-8-1-2-1-2-13-1\">\n                                    SEO & Blog inclus\n                                </td>\n                                <td class=\"px-5 py-4 text-[#A1A1AA]\" data-kid=\"1-2-8-1-2-1-2-13-2\">\n                                    —\n                                </td>\n                                <td class=\"px-5 py-4 text-[#A1A1AA]\" data-kid=\"1-2-8-1-2-1-2-13-3\">\n                                    —\n                                </td>\n                                <td class=\"px-5 py-4 text-[#087F5B]\" data-kid=\"1-2-8-1-2-1-2-13-4\">\n                                    ✓\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <div class=\"grid gap-3 border-t border-[#D1CBBF] bg-[#F4F2EC] px-5 py-4 text-[11px] text-[#52525B] sm:grid-cols-2\" data-kid=\"1-2-8-1-2-2\">\n                        <p data-kid=\"1-2-8-1-2-2-1\">\n                            <strong class=\"text-[#18181B]\" data-kid=\"1-2-8-1-2-2-1-1\">\n                                Bailleur Pro :\n                            </strong>\n                            +5 biens pour 2 000 FCFA/mois, jusqu’à 35 biens max.\n                        </p>\n                        <p data-kid=\"1-2-8-1-2-2-2\">\n                            <strong class=\"text-[#18181B]\" data-kid=\"1-2-8-1-2-2-2-1\">\n                                Agence Pro :\n                            </strong>\n                            pack +100 biens pour 5 000 FCFA/mois.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-b border-[#E4E0D8] bg-white px-5 py-20 sm:px-8 sm:py-28 lg:px-10\" data-kid=\"1-2-9\" id=\"faq\">\n            <div class=\"mx-auto max-w-[920px]\" data-kid=\"1-2-9-1\">\n                <div class=\"reveal\" data-kid=\"1-2-9-1-1\">\n                    <p class=\"text-[11px] font-semibold uppercase tracking-[.17em] text-[#71717A]\" data-kid=\"1-2-9-1-1-1\">\n                        Questions de gestion\n                    </p>\n                    <h2 class=\"mt-5 text-[clamp(2.3rem,4.5vw,4.6rem)] font-semibold leading-[.95] tracking-[-.07em] text-[#18181B]\" data-kid=\"1-2-9-1-1-2\">\n                        Les réponses avant\n                        <br data-kid=\"1-2-9-1-1-2-1\"/>\n                        <span class=\"serif font-normal italic text-[#52525B]\" data-kid=\"1-2-9-1-1-2-2\">\n                            de commencer.\n                        </span>\n                    </h2>\n                </div>\n                <div class=\"reveal mt-12 border-y border-[#D1CBBF]\" data-kid=\"1-2-9-1-2\">\n                    <details class=\"border-b border-[#E4E0D8] py-5\" data-kid=\"1-2-9-1-2-1\" open=\"\">\n                        <summary class=\"flex cursor-pointer list-none items-center justify-between gap-5 text-[14px] font-semibold text-[#18181B]\" data-kid=\"1-2-9-1-2-1-1\">\n                            <span data-kid=\"1-2-9-1-2-1-1-1\">\n                                Quelle est la différence entre Découverte, Bailleur Pro et Agence Pro ?\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-chevron-down faq-chevron icon\" data-kid=\"1-2-9-1-2-1-1-2\" style=\"color:#18181B;width:17px;height:17px\">\n                            </i>\n                        </summary>\n                        <div class=\"faq-answer pt-4 text-[13px] leading-relaxed text-[#52525B]\" data-kid=\"1-2-9-1-2-1-2\">\n                            Découverte est gratuit à vie pour 1 bien avec une gestion basique et des quittances PDF manuelles. Bailleur Pro, à 5 000 FCFA/mois ou 4 000 FCFA/mois avec facturation annuelle, débloque le Mobile Money, le portail locataire et la Marketplace Lokka jusqu’à 15 biens. Agence Pro, à 25 000 FCFA/mois ou 20 000 FCFA/mois annuels, ajoute les mandats, les reversements, le domaine personnalisé et le SEO/blog pour 50 biens inclus.\n                        </div>\n                    </details>\n                    <details class=\"border-b border-[#E4E0D8] py-5\" data-kid=\"1-2-9-1-2-2\">\n                        <summary class=\"flex cursor-pointer list-none items-center justify-between gap-5 text-[14px] font-semibold text-[#18181B]\" data-kid=\"1-2-9-1-2-2-1\">\n                            <span data-kid=\"1-2-9-1-2-2-1-1\">\n                                Que se passe-t-il si je dépasse le plafond de biens ?\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-chevron-down faq-chevron icon\" data-kid=\"1-2-9-1-2-2-1-2\" style=\"color:#18181B;width:17px;height:17px\">\n                            </i>\n                        </summary>\n                        <div class=\"faq-answer pt-4 text-[13px] leading-relaxed text-[#52525B]\" data-kid=\"1-2-9-1-2-2-2\">\n                            Vous pouvez ajouter +5 biens pour 2 000 FCFA/mois en Bailleur Pro, jusqu’à 35 biens maximum, ou un pack +100 biens pour 5 000 FCFA/mois en Agence Pro.\n                        </div>\n                    </details>\n                    <details class=\"border-b border-[#E4E0D8] py-5\" data-kid=\"1-2-9-1-2-3\">\n                        <summary class=\"flex cursor-pointer list-none items-center justify-between gap-5 text-[14px] font-semibold text-[#18181B]\" data-kid=\"1-2-9-1-2-3-1\">\n                            <span data-kid=\"1-2-9-1-2-3-1-1\">\n                                Comment les locataires accèdent-ils à leurs quittances ?\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-chevron-down faq-chevron icon\" data-kid=\"1-2-9-1-2-3-1-2\" style=\"color:#18181B;width:17px;height:17px\">\n                            </i>\n                        </summary>\n                        <div class=\"faq-answer pt-4 text-[13px] leading-relaxed text-[#52525B]\" data-kid=\"1-2-9-1-2-3-2\">\n                            Ils reçoivent un accès sécurisé par email ou téléphone avec un code OTP. Leur espace web contient l’historique des mois payés et les quittances PDF officielles avec QR Code.\n                        </div>\n                    </details>\n                    <details class=\"border-b border-[#E4E0D8] py-5\" data-kid=\"1-2-9-1-2-4\">\n                        <summary class=\"flex cursor-pointer list-none items-center justify-between gap-5 text-[14px] font-semibold text-[#18181B]\" data-kid=\"1-2-9-1-2-4-1\">\n                            <span data-kid=\"1-2-9-1-2-4-1-1\">\n                                Comment fonctionne l’encaissement MTN MoMo et Moov Money ?\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-chevron-down faq-chevron icon\" data-kid=\"1-2-9-1-2-4-1-2\" style=\"color:#18181B;width:17px;height:17px\">\n                            </i>\n                        </summary>\n                        <div class=\"faq-answer pt-4 text-[13px] leading-relaxed text-[#52525B]\" data-kid=\"1-2-9-1-2-4-2\">\n                            Dès que la transaction est confirmée, le tableau de bord s’actualise et la quittance est générée automatiquement. Le locataire peut ensuite la retrouver depuis son portail.\n                        </div>\n                    </details>\n                    <details class=\"border-b border-[#E4E0D8] py-5\" data-kid=\"1-2-9-1-2-5\">\n                        <summary class=\"flex cursor-pointer list-none items-center justify-between gap-5 text-[14px] font-semibold text-[#18181B]\" data-kid=\"1-2-9-1-2-5-1\">\n                            <span data-kid=\"1-2-9-1-2-5-1-1\">\n                                Comment Lokka applique-t-il la Loi n° 2022-30 ?\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-chevron-down faq-chevron icon\" data-kid=\"1-2-9-1-2-5-1-2\" style=\"color:#18181B;width:17px;height:17px\">\n                            </i>\n                        </summary>\n                        <div class=\"faq-answer pt-4 text-[13px] leading-relaxed text-[#52525B]\" data-kid=\"1-2-9-1-2-5-2\">\n                            Le plafond de caution est limité à 3 mois de loyer, les quittances comportent les mentions légales obligatoires et la commission de gestion agence est plafonnée à 10% selon le périmètre présenté.\n                        </div>\n                    </details>\n                    <details class=\"border-b border-[#E4E0D8] py-5\" data-kid=\"1-2-9-1-2-6\">\n                        <summary class=\"flex cursor-pointer list-none items-center justify-between gap-5 text-[14px] font-semibold text-[#18181B]\" data-kid=\"1-2-9-1-2-6-1\">\n                            <span data-kid=\"1-2-9-1-2-6-1-1\">\n                                Je vis à l’étranger, Lokka est-il adapté pour gérer mes biens au Bénin ?\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-chevron-down faq-chevron icon\" data-kid=\"1-2-9-1-2-6-1-2\" style=\"color:#18181B;width:17px;height:17px\">\n                            </i>\n                        </summary>\n                        <div class=\"faq-answer pt-4 text-[13px] leading-relaxed text-[#52525B]\" data-kid=\"1-2-9-1-2-6-2\">\n                            Oui. Vous suivez les loyers avec un contexte FCFA / Euros ou Dollars, les notifications de paiement MoMo et l’archivage des documents.\n                        </div>\n                    </details>\n                    <details class=\"py-5\" data-kid=\"1-2-9-1-2-7\">\n                        <summary class=\"flex cursor-pointer list-none items-center justify-between gap-5 text-[14px] font-semibold text-[#18181B]\" data-kid=\"1-2-9-1-2-7-1\">\n                            <span data-kid=\"1-2-9-1-2-7-1-1\">\n                                Mes locataires doivent-ils payer pour utiliser Lokka ?\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-chevron-down faq-chevron icon\" data-kid=\"1-2-9-1-2-7-1-2\" style=\"color:#18181B;width:17px;height:17px\">\n                            </i>\n                        </summary>\n                        <div class=\"faq-answer pt-4 text-[13px] leading-relaxed text-[#52525B]\" data-kid=\"1-2-9-1-2-7-2\">\n                            Non, Lokka est 100% gratuit pour vos locataires. Ils peuvent recevoir leurs rappels et quittances, payer leur loyer et suivre leur bail sans frais supplémentaire.\n                        </div>\n                    </details>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-b border-[#E4E0D8] bg-[#FAF9F6] px-5 py-20 sm:px-8 sm:py-28 lg:px-10\" data-kid=\"1-2-10\" id=\"testimonials\">\n            <div class=\"mx-auto max-w-[1120px]\" data-kid=\"1-2-10-1\">\n                <div class=\"reveal max-w-[630px]\" data-kid=\"1-2-10-1-1\">\n                    <p class=\"text-[11px] font-semibold uppercase tracking-[.17em] text-[#71717A]\" data-kid=\"1-2-10-1-1-1\">\n                        Notes de terrain\n                    </p>\n                    <h2 class=\"mt-5 text-[clamp(2.2rem,4vw,4.2rem)] font-semibold leading-[.95] tracking-[-.07em] text-[#18181B]\" data-kid=\"1-2-10-1-1-2\">\n                        Des traces qui parlent\n                        <br data-kid=\"1-2-10-1-1-2-1\"/>\n                        <span class=\"serif font-normal italic text-[#52525B]\" data-kid=\"1-2-10-1-1-2-2\">\n                            à chaque métier.\n                        </span>\n                    </h2>\n                </div>\n                <div class=\"reveal mt-12 grid gap-8 lg:grid-cols-3\" data-kid=\"1-2-10-1-2\">\n                    <blockquote class=\"testimonial-note pl-5\" data-kid=\"1-2-10-1-2-1\">\n                        <p class=\"text-[16px] leading-relaxed text-[#18181B]\" data-kid=\"1-2-10-1-2-1-1\">\n                            “Mes locataires téléchargent leurs quittances PDF certifiées directement depuis leur espace web, et je n’ai plus jamais à rédiger de reçus papier manuscrits.”\n                        </p>\n                        <footer class=\"mt-5 text-[11px] leading-relaxed text-[#71717A]\" data-kid=\"1-2-10-1-2-1-2\">\n                            <strong class=\"font-semibold text-[#18181B]\" data-kid=\"1-2-10-1-2-1-2-1\">\n                                Aïcha Houndété\n                            </strong>\n                            <br data-kid=\"1-2-10-1-2-1-2-2\"/>\n                            Propriétaire Bailleur · Calavi · 8 logements\n                        </footer>\n                    </blockquote>\n                    <blockquote class=\"testimonial-note pl-5\" data-kid=\"1-2-10-1-2-2\">\n                        <p class=\"text-[16px] leading-relaxed text-[#18181B]\" data-kid=\"1-2-10-1-2-2-1\">\n                            “Grâce au site vitrine généré en 1 clic et aux comptes-rendus de gestion pour nos propriétaires mandants, notre agence a gagné une crédibilité exceptionnelle.”\n                        </p>\n                        <footer class=\"mt-5 text-[11px] leading-relaxed text-[#71717A]\" data-kid=\"1-2-10-1-2-2-2\">\n                            <strong class=\"font-semibold text-[#18181B]\" data-kid=\"1-2-10-1-2-2-2-1\">\n                                Aristide Gbaguidi\n                            </strong>\n                            <br data-kid=\"1-2-10-1-2-2-2-2\"/>\n                            Directeur d’agence · Cotonou Haie Vive · 24 lots\n                        </footer>\n                    </blockquote>\n                    <blockquote class=\"testimonial-note pl-5\" data-kid=\"1-2-10-1-2-3\">\n                        <p class=\"text-[16px] leading-relaxed text-[#18181B]\" data-kid=\"1-2-10-1-2-3-1\">\n                            “Gérant mes biens à Cotonou depuis Paris, le double affichage FCFA / Euros et les notifications de paiement MoMo me procurent une vraie tranquillité d’esprit.”\n                        </p>\n                        <footer class=\"mt-5 text-[11px] leading-relaxed text-[#71717A]\" data-kid=\"1-2-10-1-2-3-2\">\n                            <strong class=\"font-semibold text-[#18181B]\" data-kid=\"1-2-10-1-2-3-2-1\">\n                                Dr. Fabrice Tossou\n                            </strong>\n                            <br data-kid=\"1-2-10-1-2-3-2-2\"/>\n                            Investisseur diaspora · Paris & Cotonou · 6 biens\n                        </footer>\n                    </blockquote>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[#18181B] px-5 py-20 text-white sm:px-8 sm:py-28 lg:px-10\" data-kid=\"1-2-11\" id=\"final-cta\">\n            <div class=\"mx-auto grid max-w-[1120px] gap-12 lg:grid-cols-[1.1fr_.75fr] lg:items-end lg:gap-24\" data-kid=\"1-2-11-1\">\n                <div class=\"reveal\" data-kid=\"1-2-11-1-1\">\n                    <p class=\"text-[11px] font-semibold uppercase tracking-[.17em] text-white/55\" data-kid=\"1-2-11-1-1-1\">\n                        Un espace clair pour commencer\n                    </p>\n                    <h2 class=\"mt-5 max-w-[680px] text-[clamp(2.7rem,6vw,6rem)] font-semibold leading-[.91] tracking-[-.075em] text-white\" data-kid=\"1-2-11-1-1-2\">\n                        Prêt à reprendre\n                        <br data-kid=\"1-2-11-1-1-2-1\"/>\n                        <span class=\"serif font-normal italic text-white/70\" data-kid=\"1-2-11-1-1-2-2\">\n                            le contrôle ?\n                        </span>\n                    </h2>\n                    <p class=\"mt-7 max-w-[520px] text-[15px] leading-relaxed text-white/70\" data-kid=\"1-2-11-1-1-3\">\n                        Créez votre espace, ajoutez votre premier logement et invitez un locataire. Un code de connexion vous sera envoyé.\n                    </p>\n                </div>\n                <div class=\"reveal border-t border-white/20 pt-5\" data-kid=\"1-2-11-1-2\">\n                    <form data-kid=\"1-2-11-1-2-1\" data-signup-form=\"\">\n                        <label class=\"mb-2 block text-[12px] font-semibold text-white\" data-kid=\"1-2-11-1-2-1-1\" for=\"final-email-luminous\">\n                            Votre adresse email\n                        </label>\n                        <div class=\"flex flex-col gap-2\" data-kid=\"1-2-11-1-2-1-2\">\n                            <input class=\"min-h-[48px] rounded-[6px] border border-white/20 bg-white px-4 text-[14px] text-[#18181B] outline-none placeholder:text-[#A1A1AA] focus:border-white\" data-email=\"\" data-kid=\"1-2-11-1-2-1-2-1\" id=\"final-email-luminous\" placeholder=\"Votre adresse email\" required=\"\" type=\"email\"/>\n                            <button class=\"inline-flex min-h-[48px] items-center justify-center gap-2 rounded-[6px] bg-white px-5 text-[13px] font-semibold text-[#18181B] hover:bg-[#E6F5EF] hover:text-[#087F5B]\" data-kid=\"1-2-11-1-2-1-2-2\" data-submit-button=\"\" type=\"submit\">\n                                <span data-kid=\"1-2-11-1-2-1-2-2-1\" data-submit-label=\"\">\n                                    Créer mon espace\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-right icon\" data-kid=\"1-2-11-1-2-1-2-2-2\" style=\"color:currentColor;width:16px;height:16px\">\n                                </i>\n                            </button>\n                        </div>\n                        <p aria-live=\"polite\" class=\"form-feedback mt-3 text-[12px] leading-relaxed text-white/55\" data-dynamic=\"true\" data-feedback=\"\" data-kid=\"1-2-11-1-2-1-3\" data-name=\"form feedback message\" data-reason=\"text updated to confirmation message by script\">\n                            Essai gratuit 14 jours · Sans carte bancaire.\n                        </p>\n                    </form>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[#18181B] px-5 pb-7 text-white sm:px-8 lg:px-10\" data-kid=\"1-3\">\n        <div class=\"mx-auto flex max-w-[1120px] flex-col gap-5 border-t border-white/15 pt-7 text-[11px] text-white/50 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-3-1\">\n            <div class=\"flex items-center gap-2\" data-kid=\"1-3-1-1\">\n                <span class=\"flex h-7 w-7 items-center justify-center rounded-[5px] bg-white\" data-kid=\"1-3-1-1-1\">\n                    <svg data-kid=\"1-3-1-1-1-1\" fill=\"none\" height=\"15\" viewbox=\"0 0 500 500\" width=\"15\">\n                        <path d=\"M195 87.5 L277 87.5 L231 237.5 L369 237.5 L323 372.5 L141.5 372.5 L180 252.5 L276.5 252.5 L230.5 317.5 L197.5 317.5 L217 252.5 M195 87.5\" stroke=\"#18181B\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"16\">\n                        </path>\n                    </svg>\n                </span>\n                <span class=\"serif text-[20px] text-white\" data-kid=\"1-3-1-1-2\">\n                    Lokka.\n                </span>\n            </div>\n            <span data-kid=\"1-3-1-2\">\n                Gestion locative pour le Bénin et la diaspora · © 2026 Lokka\n            </span>\n            <span data-kid=\"1-3-1-3\">\n                FCFA · MTN MoMo · Moov Money · Loi 2022-30\n            </span>\n        </div>\n    </footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    (function () {\n    const root = document.querySelector('[data-lokka-root]');\n    if (!root) return;\n    const q = (selector) => root.querySelector(selector);\n    const qa = (selector) => Array.from(root.querySelectorAll(selector));\n\n    qa('[data-scroll]').forEach((button) => {\n      button.addEventListener('click', function () {\n        const target = q(button.getAttribute('data-scroll'));\n        if (target) target.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });\n      });\n    });\n\n    qa('[data-dashboard-tab]').forEach((tab) => {\n      tab.addEventListener('click', function () {\n        const view = tab.getAttribute('data-dashboard-tab');\n        qa('[data-dashboard-tab]').forEach((item) => item.setAttribute('aria-selected', String(item === tab)));\n        qa('[data-dashboard-view]').forEach((panel) => panel.classList.toggle('is-active', panel.getAttribute('data-dashboard-view') === view));\n      });\n    });\n\n    const receiptToggle = q('[data-receipt-toggle]');\n    const receiptDrawer = q('[data-receipt-drawer]');\n    if (receiptToggle && receiptDrawer) {\n      receiptToggle.addEventListener('click', function () {\n        const isOpen = receiptDrawer.classList.toggle('is-open');\n        receiptToggle.setAttribute('aria-expanded', String(isOpen));\n        const icon = receiptToggle.querySelector('i');\n        if (icon) icon.className = isOpen ? 'ti ti-arrow-up icon' : 'ti ti-arrow-down icon';\n      });\n    }\n\n    const detailCopy = {\n      koudjo: ['Koudjo Dossou', 'Villa Fidjrossè Plage', '350 000 FCFA', 'MTN MoMo confirmé', 'LOK-2026-0891'],\n      berenice: ['Bérénice Agossou', 'Studio Meublé · Haie Vive', '120 000 FCFA', 'Moov Money confirmé', 'LOK-2026-0890'],\n      estelle: ['Estelle Houndété', 'Duplex Cadjehoun', '450 000 FCFA', 'Virement BOA confirmé', 'LOK-2026-0865']\n    };\n    qa('[data-transaction]').forEach((row) => {\n      row.addEventListener('click', function () {\n        qa('[data-transaction]').forEach((item) => item.classList.toggle('is-selected', item === row));\n        const info = detailCopy[row.getAttribute('data-transaction')];\n        const rail = q('.dash-rail');\n        if (!info || !rail) return;\n        const name = rail.querySelector('h3');\n        const property = rail.querySelector('h3 + p');\n        const amount = rail.querySelector('.tabular');\n        const method = rail.querySelector('.dash-rail .text-\\[10px\\].font-semibold.text-\\[\\#087F5B\\]');\n        if (name) name.textContent = info[0];\n        if (property) property.textContent = info[1];\n        if (amount) amount.innerHTML = info[2].replace(' FCFA', ' <span class=\"font-sans text-[11px] font-medium tracking-normal text-[#71717A]\">FCFA</span>');\n        if (method) method.lastChild.textContent = info[3];\n      });\n    });\n\n    qa('[data-role-tab]').forEach((tab) => {\n      tab.addEventListener('click', function () {\n        const role = tab.getAttribute('data-role-tab');\n        qa('[data-role-tab]').forEach((item) => {\n          const selected = item === tab;\n          item.setAttribute('aria-selected', String(selected));\n          item.classList.toggle('bg-[#18181B]', selected);\n          item.classList.toggle('text-white', selected);\n          item.classList.toggle('text-[#71717A]', !selected);\n        });\n        qa('[data-role-view]').forEach((panel) => panel.classList.toggle('is-active', panel.getAttribute('data-role-view') === role));\n      });\n    });\n\n    const publishButton = q('[data-publish-button]');\n    const publishState = q('[data-publish-state]');\n    if (publishButton && publishState) publishButton.addEventListener('click', function () { publishButton.innerHTML = 'Annonce publiée <i class=\"ti ti-check icon\" aria-hidden=\"true\" style=\"color:#FFFFFF;width:14px;height:14px\"></i>'; publishState.classList.add('is-visible'); });\n    const requestButton = q('[data-request-button]');\n    const requestState = q('[data-request-state]');\n    if (requestButton && requestState) requestButton.addEventListener('click', function () { requestButton.textContent = 'Visite demandée'; requestState.classList.add('is-visible'); });\n\n    const pricingToggle = q('[data-pricing-toggle]');\n    if (pricingToggle) pricingToggle.addEventListener('click', function () {\n      const annual = pricingToggle.getAttribute('aria-pressed') === 'true';\n      const nextAnnual = !annual;\n      pricingToggle.setAttribute('aria-pressed', String(nextAnnual));\n      pricingToggle.classList.toggle('bg-[#18181B]', nextAnnual);\n      pricingToggle.classList.toggle('bg-[#D1CBBF]', !nextAnnual);\n      const thumb = pricingToggle.querySelector('.switch-thumb');\n      if (thumb) thumb.style.transform = nextAnnual ? 'translateX(20px)' : 'translateX(0)';\n      qa('[data-annual]').forEach((item) => item.setAttribute('data-annual', String(nextAnnual)));\n      const monthlyLabel = q('[data-monthly-label]');\n      const annualLabel = q('[data-annual-label]');\n      if (monthlyLabel) monthlyLabel.style.color = nextAnnual ? '#71717A' : '#18181B';\n      if (annualLabel) annualLabel.style.color = nextAnnual ? '#18181B' : '#71717A';\n    });\n\n    qa('details').forEach((detail) => detail.addEventListener('toggle', function () { if (detail.open) qa('details').filter((item) => item !== detail).forEach((item) => item.removeAttribute('open')); }));\n\n    qa('[data-signup-form]').forEach((form) => {\n      form.addEventListener('submit', function (event) {\n        event.preventDefault();\n        const input = form.querySelector('[data-email]');\n        const button = form.querySelector('[data-submit-button]');\n        const label = form.querySelector('[data-submit-label]');\n        const feedback = form.querySelector('[data-feedback]');\n        const email = input ? input.value.trim() : '';\n        if (!email || !button || !feedback) return;\n        button.disabled = true;\n        if (label) label.textContent = 'Envoi du code…';\n        window.setTimeout(function () {\n          button.disabled = false;\n          if (label) label.textContent = 'Code envoyé';\n          feedback.textContent = 'Code envoyé à ' + email + '. Vérifiez votre boîte de réception.';\n          feedback.style.color = form.closest('#final-cta') ? 'rgba(255,255,255,.88)' : '#087F5B';\n        }, 650);\n      });\n    });\n\n    if (!window.gsap || !window.ScrollTrigger) return;\n    gsap.registerPlugin(ScrollTrigger);\n    const mm = gsap.matchMedia();\n    mm.add({ reduced: '(prefers-reduced-motion: reduce)', desktop: '(min-width: 900px)' }, function (context) {\n      const conditions = context.conditions || {};\n      const reduced = conditions.reduced;\n      const desktop = conditions.desktop;\n      const allReveals = qa('.reveal');\n      const finalElements = qa('.hero-kicker, .hero-title, .hero-copy, .hero-form, .hero-proof, .dashboard-card, .reveal, .metric-bar, .timeline-line');\n      if (reduced) {\n        gsap.set(finalElements, { autoAlpha: 1, x: 0, y: 0, rotationX: 0, rotationY: 0, scaleY: 1 });\n        return;\n      }\n      const intro = gsap.timeline({ defaults: { ease: 'power3.out' } });\n      intro.from('.hero-kicker', { autoAlpha: 0, y: 12, duration: .4 })\n        .from('.hero-title', { autoAlpha: 0, y: 22, duration: .7 }, '-=.16')\n        .from('.hero-copy', { autoAlpha: 0, y: 14, duration: .45 }, '-=.3')\n        .from('.hero-form', { autoAlpha: 0, y: 14, duration: .45 }, '-=.24')\n        .from('.hero-proof', { autoAlpha: 0, y: 10, duration: .35 }, '-=.24');\n      if (desktop) {\n        intro.from('.dashboard-card', { autoAlpha: 0, y: 56, rotationX: 14, rotationY: -8, duration: 1.05 }, '-=.12');\n        gsap.to('.dashboard-card', { rotationX: 0, rotationY: 0, y: -18, ease: 'none', scrollTrigger: { trigger: '#product-dashboard', start: 'top 88%', end: 'top 30%', scrub: .7, once: false } });\n      } else {\n        intro.from('.dashboard-card', { autoAlpha: 0, y: 32, duration: .75 }, '-=.12');\n      }\n      gsap.from(qa('.metric-bar'), { scaleY: 0, transformOrigin: 'center bottom', duration: .7, stagger: .07, ease: 'power2.out', scrollTrigger: { trigger: '.metric-bar', start: 'top 88%', once: true } });\n      allReveals.forEach(function (element) {\n        gsap.from(element, { autoAlpha: 0, y: 26, duration: .65, ease: 'power3.out', scrollTrigger: { trigger: element, start: 'top 84%', once: true } });\n      });\n      const line = q('.timeline-line');\n      if (line) gsap.from(line, { scaleX: 0, transformOrigin: 'left center', duration: .9, ease: 'power2.inOut', scrollTrigger: { trigger: line, start: 'top 82%', once: true } });\n      const stage = q('.dashboard-stage');\n      const surface = q('.dashboard-card');\n      if (desktop && stage && surface) {\n        const xTo = gsap.quickTo(surface, 'rotationY', { duration: .55, ease: 'power3.out' });\n        const yTo = gsap.quickTo(surface, 'rotationX', { duration: .55, ease: 'power3.out' });\n        const resetX = gsap.quickTo(surface, 'rotationY', { duration: .8, ease: 'power3.out' });\n        const resetY = gsap.quickTo(surface, 'rotationX', { duration: .8, ease: 'power3.out' });\n        stage.addEventListener('pointermove', function (event) { const rect = stage.getBoundingClientRect(); const px = (event.clientX - rect.left) / rect.width - .5; const py = (event.clientY - rect.top) / rect.height - .5; xTo(px * 2.4); yTo(5 - py * 2.2); });\n        stage.addEventListener('pointerleave', function () { resetX(0); resetY(0); });\n        return function () { stage.removeEventListener('pointermove', function () {}); stage.removeEventListener('pointerleave', function () {}); };\n      }\n    });\n    window.addEventListener('load', function () { ScrollTrigger.refresh(); }, { once: true });\n  })();\n</script>\n",
