tric-slot\" data-kid=\"1-2-6-1-2-3\">\n                        <div class=\"lk-metric-label\" data-kid=\"1-2-6-1-2-3-1\">\n                            Recouvrement MoMo\n                        </div>\n                        <div class=\"lk-value lk-mono mt-3\" data-kid=\"1-2-6-1-2-3-2\">\n                            98,2%\n                        </div>\n                        <div class=\"lk-record-meta mt-1\" data-kid=\"1-2-6-1-2-3-3\">\n                            taux communiqué\n                        </div>\n                    </div>\n                    <div class=\"lk-metric-slot\" data-kid=\"1-2-6-1-2-4\">\n                        <div class=\"lk-metric-label\" data-kid=\"1-2-6-1-2-4-1\">\n                            Conformité affichée\n                        </div>\n                        <div class=\"lk-value lk-mono mt-3\" data-kid=\"1-2-6-1-2-4-2\">\n                            100%\n                        </div>\n                        <div class=\"lk-record-meta mt-1\" data-kid=\"1-2-6-1-2-4-3\">\n                            Loi n° 2022-30\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-14 grid gap-12 lg:grid-cols-3\" data-kid=\"1-2-6-1-3\">\n                    <div class=\"lk-quote\" data-kid=\"1-2-6-1-3-1\">\n                        <p data-kid=\"1-2-6-1-3-1-1\">\n                            “Mes locataires téléchargent leurs quittances PDF depuis leur espace. Je n’ai plus à rédiger de reçus papier.”\n                        </p>\n                        <cite data-kid=\"1-2-6-1-3-1-2\">\n                            Aïcha Houndété\n                            <br data-kid=\"1-2-6-1-3-1-2-1\"/>\n                            Propriétaire bailleur · Calavi · 8 logements\n                        </cite>\n                    </div>\n                    <div class=\"lk-quote\" data-kid=\"1-2-6-1-3-2\">\n                        <p data-kid=\"1-2-6-1-3-2-1\">\n                            “Les mandats, les 10% de commission et les reversements restent lisibles pour nos propriétaires.”\n                        </p>\n                        <cite data-kid=\"1-2-6-1-3-2-2\">\n                            Aristide Gbaguidi\n                            <br data-kid=\"1-2-6-1-3-2-2-1\"/>\n                            Directeur d’agence · Cotonou Haie Vive · 24 lots\n                        </cite>\n                    </div>\n                    <div class=\"lk-quote\" data-kid=\"1-2-6-1-3-3\">\n                        <p data-kid=\"1-2-6-1-3-3-1\">\n                            “Depuis Paris, je suis les paiements en FCFA et les documents sans intermédiaire opaque.”\n                        </p>\n                        <cite data-kid=\"1-2-6-1-3-3-2\">\n                            Dr. Fabrice Tossou\n                            <br data-kid=\"1-2-6-1-3-3-2-1\"/>\n                            Investisseur diaspora · Paris & Cotonou · 6 biens\n                        </cite>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"lk-section-space border-t border-[#E4E0D8] bg-[#FAF9F6]\" data-kid=\"1-2-7\" id=\"tarifs\">\n            <div class=\"mx-auto max-w-[1240px] px-6\" data-kid=\"1-2-7-1\">\n                <div class=\"flex flex-col gap-7 border-b border-[#E4E0D8] pb-8 lg:flex-row lg:items-end lg:justify-between\" data-kid=\"1-2-7-1-1\">\n                    <div data-kid=\"1-2-7-1-1-1\">\n                        <p class=\"lk-kicker mb-4\" data-kid=\"1-2-7-1-1-1-1\">\n                            Plans & limites\n                        </p>\n                        <h2 class=\"lk-editorial m-0 max-w-[670px] text-[clamp(2.5rem,4.8vw,4.5rem)] leading-[.98] tracking-[-.04em]\" data-kid=\"1-2-7-1-1-1-2\">\n                            Le bon niveau de contrôle, sans surprise.\n                        </h2>\n                        <p class=\"mt-5 max-w-[620px] text-[15px] leading-[1.6] text-[#64635F]\" data-kid=\"1-2-7-1-1-1-3\">\n                            Les forfaits sont affichés en FCFA. Les fonctionnalités et les limites restent comparables au même endroit.\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-7-1-1-2\">\n                        <span class=\"text-[12px] font-bold text-[#9B978F]\" data-kid=\"1-2-7-1-1-2-1\" id=\"billing-monthly-label\">\n                            Mensuel\n                        </span>\n                        <button aria-label=\"Basculer entre facturation annuelle et mensuelle\" aria-pressed=\"true\" class=\"relative flex h-8 w-14 items-center rounded-full border border-[#18181B] bg-[#18181B] p-1\" data-kid=\"1-2-7-1-1-2-2\" data-name=\"billing interval toggle\" id=\"billing-toggle\" type=\"button\">\n                            <span class=\"block h-6 w-6 translate-x-6 rounded-full bg-white\" data-kid=\"1-2-7-1-1-2-2-1\" data-name=\"billing interval knob\" id=\"billing-knob\">\n                            </span>\n                        </button>\n                        <span class=\"text-[12px] font-bold text-[#18181B]\" data-kid=\"1-2-7-1-1-2-3\" id=\"billing-annual-label\">\n                            Annuel\n                        </span>\n                        <span class=\"rounded bg-[#E6F5EF] px-2 py-1 text-[10px] font-bold text-[#087F5B]\" data-kid=\"1-2-7-1-1-2-4\">\n                            -20%\n                        </span>\n                    </div>\n                </div>\n                <div class=\"lk-table-wrap mt-10 bg-white\" data-kid=\"1-2-7-1-2\">\n                    <table class=\"lk-table\" data-kid=\"1-2-7-1-2-1\">\n                        <thead data-kid=\"1-2-7-1-2-1-1\">\n                            <tr data-kid=\"1-2-7-1-2-1-1-1\">\n                                <th data-kid=\"1-2-7-1-2-1-1-1-1\">\n                                    Opérations du dossier\n                                </th>\n                                <th data-kid=\"1-2-7-1-2-1-1-1-2\">\n                                    <span class=\"block text-[14px]\" data-kid=\"1-2-7-1-2-1-1-1-2-1\">\n                                        Découverte\n                                    </span>\n                                    <span class=\"mt-2 block text-[20px] tracking-[-.03em]\" data-dynamic=\"true\" data-kid=\"1-2-7-1-2-1-1-1-2-2\" data-name=\"pricing tier amount\" data-price-annual=\"0 FCFA\" data-price-monthly=\"0 FCFA\" data-reason=\"text updated by interval toggle script\">\n                                        0 FCFA\n                                    </span>\n                                    <span class=\"mt-1 block text-[10px] font-medium text-[#64635F]\" data-kid=\"1-2-7-1-2-1-1-1-2-3\">\n                                        1 seul bien\n                                    </span>\n                                </th>\n                                <th class=\"lk-plan-focus\" data-kid=\"1-2-7-1-2-1-1-1-3\">\n                                    <span class=\"block text-[14px]\" data-kid=\"1-2-7-1-2-1-1-1-3-1\">\n                                        Bailleur Pro\n                                    </span>\n                                    <span class=\"mt-2 block text-[20px] tracking-[-.03em]\" data-dynamic=\"true\" data-kid=\"1-2-7-1-2-1-1-1-3-2\" data-name=\"pricing tier amount\" data-price-annual=\"4 000 FCFA\" data-price-monthly=\"5 000 FCFA\" data-reason=\"text updated by interval toggle script\">\n                                        4 000 FCFA\n                                    </span>\n                                    <span class=\"mt-1 block text-[10px] font-medium text-[#64635F]\" data-kid=\"1-2-7-1-2-1-1-1-3-3\">\n                                        Jusqu’à 15 biens\n                                    </span>\n                                </th>\n                                <th data-kid=\"1-2-7-1-2-1-1-1-4\">\n                                    <span class=\"block text-[14px]\" data-kid=\"1-2-7-1-2-1-1-1-4-1\">\n                                        Agence Pro\n                                    </span>\n                                    <span class=\"mt-2 block text-[20px] tracking-[-.03em]\" data-dynamic=\"true\" data-kid=\"1-2-7-1-2-1-1-1-4-2\" data-name=\"pricing tier amount\" data-price-annual=\"20 000 FCFA\" data-price-monthly=\"25 000 FCFA\" data-reason=\"text updated by interval toggle script\">\n                                        20 000 FCFA\n                                    </span>\n                                    <span class=\"mt-1 block text-[10px] font-medium text-[#64635F]\" data-kid=\"1-2-7-1-2-1-1-1-4-3\">\n                                        50 biens inclus\n                                    </span>\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody data-kid=\"1-2-7-1-2-1-2\">\n                            <tr class=\"lk-group\" data-kid=\"1-2-7-1-2-1-2-1\">\n                                <td colspan=\"4\" data-kid=\"1-2-7-1-2-1-2-1-1\">\n                                    Gérer le dossier\n                                </td>\n                            </tr>\n                            <tr data-kid=\"1-2-7-1-2-1-2-2\">\n                                <td data-kid=\"1-2-7-1-2-1-2-2-1\">\n                                    Nombre de biens\n                                </td>\n                                <td data-kid=\"1-2-7-1-2-1-2-2-2\">\n                                    1 seul bien\n                                </td>\n                                <td class=\"lk-plan-focus\" data-kid=\"1-2-7-1-2-1-2-2-3\">\n                                    Jusqu’à 15 biens\n                                </td>\n                                <td data-kid=\"1-2-7-1-2-1-2-2-4\">\n                                    50 biens inclus\n     