td>\n                            </tr>\n                            <tr data-kid=\"1-2-7-1-2-1-2-15\">\n                                <td data-kid=\"1-2-7-1-2-1-2-15-1\">\n                                    Vitrine web (lien standard)\n                                </td>\n                                <td data-kid=\"1-2-7-1-2-1-2-15-2\">\n                                    <i aria-label=\"Non inclus\" class=\"ti ti-minus lk-minus\" data-kid=\"1-2-7-1-2-1-2-15-2-1\">\n                                    </i>\n                                </td>\n                                <td class=\"lk-plan-focus\" data-kid=\"1-2-7-1-2-1-2-15-3\">\n                                    <i aria-label=\"Inclus\" class=\"ti ti-check lk-check\" data-kid=\"1-2-7-1-2-1-2-15-3-1\">\n                                    </i>\n                                </td>\n                                <td data-kid=\"1-2-7-1-2-1-2-15-4\">\n                                    <i aria-label=\"Non inclus\" class=\"ti ti-minus lk-minus\" data-kid=\"1-2-7-1-2-1-2-15-4-1\">\n                                    </i>\n                                </td>\n                            </tr>\n                            <tr data-kid=\"1-2-7-1-2-1-2-16\">\n                                <td data-kid=\"1-2-7-1-2-1-2-16-1\">\n                                    Domaine personnalisé + thèmes\n                                </td>\n                                <td data-kid=\"1-2-7-1-2-1-2-16-2\">\n                                    <i aria-label=\"Non inclus\" class=\"ti ti-minus lk-minus\" data-kid=\"1-2-7-1-2-1-2-16-2-1\">\n                                    </i>\n                                </td>\n                                <td class=\"lk-plan-focus\" data-kid=\"1-2-7-1-2-1-2-16-3\">\n                                    <i aria-label=\"Non inclus\" class=\"ti ti-minus lk-minus\" data-kid=\"1-2-7-1-2-1-2-16-3-1\">\n                                    </i>\n                                </td>\n                                <td data-kid=\"1-2-7-1-2-1-2-16-4\">\n                                    <i aria-label=\"Inclus\" class=\"ti ti-check lk-check\" data-kid=\"1-2-7-1-2-1-2-16-4-1\">\n                                    </i>\n                                </td>\n                            </tr>\n                            <tr data-kid=\"1-2-7-1-2-1-2-17\">\n                                <td data-kid=\"1-2-7-1-2-1-2-17-1\">\n                                    SEO & Blog inclus\n                                </td>\n                                <td data-kid=\"1-2-7-1-2-1-2-17-2\">\n                                    <i aria-label=\"Non inclus\" class=\"ti ti-minus lk-minus\" data-kid=\"1-2-7-1-2-1-2-17-2-1\">\n                                    </i>\n                                </td>\n                                <td class=\"lk-plan-focus\" data-kid=\"1-2-7-1-2-1-2-17-3\">\n                                    <i aria-label=\"Non inclus\" class=\"ti ti-minus lk-minus\" data-kid=\"1-2-7-1-2-1-2-17-3-1\">\n                                    </i>\n                                </td>\n                                <td data-kid=\"1-2-7-1-2-1-2-17-4\">\n                                    <i aria-label=\"Inclus\" class=\"ti ti-check lk-check\" data-kid=\"1-2-7-1-2-1-2-17-4-1\">\n                                    </i>\n                                </td>\n                            </tr>\n                            <tr data-kid=\"1-2-7-1-2-1-2-18\">\n                                <td data-kid=\"1-2-7-1-2-1-2-18-1\">\n                                    Accès aux fonctionnalités essentielles\n                                </td>\n                                <td data-kid=\"1-2-7-1-2-1-2-18-2\">\n                                    <i aria-label=\"Inclus\" class=\"ti ti-check lk-check\" data-kid=\"1-2-7-1-2-1-2-18-2-1\">\n                                    </i>\n                                </td>\n                                <td class=\"lk-plan-focus\" data-kid=\"1-2-7-1-2-1-2-18-3\">\n                                    <i aria-label=\"Inclus\" class=\"ti ti-check lk-check\" data-kid=\"1-2-7-1-2-1-2-18-3-1\">\n                                    </i>\n                                </td>\n                                <td data-kid=\"1-2-7-1-2-1-2-18-4\">\n                                    <i aria-label=\"Inclus\" class=\"ti ti-check lk-check\" data-kid=\"1-2-7-1-2-1-2-18-4-1\">\n                                    </i>\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n                <div class=\"mt-6 grid gap-2 border-b border-[#E4E0D8] pb-7 text-[12px] text-[#64635F]\" data-kid=\"1-2-7-1-3\">\n                    <p class=\"m-0\" data-kid=\"1-2-7-1-3-1\">\n                        <strong class=\"text-[#18181B]\" data-kid=\"1-2-7-1-3-1-1\">\n                            Bailleur Pro :\n                        </strong>\n                        +5 biens pour 2 000 FCFA/mois (jusqu’à 35 biens max)\n                    </p>\n                    <p class=\"m-0\" data-kid=\"1-2-7-1-3-2\">\n                        <strong class=\"text-[#18181B]\" data-kid=\"1-2-7-1-3-2-1\">\n                            Agence Pro :\n                        </strong>\n                        pack +100 biens pour 5 000 FCFA/mois\n                    </p>\n                    <p class=\"m-0 text-[11px]\" data-kid=\"1-2-7-1-3-3\">\n                        Annuel : Bailleur Pro 48 000 FCFA facturés par an (-20%) · Agence Pro 240 000 FCFA facturés par an (-20%).\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"lk-section-space border-t border-[#E4E0D8] bg-white\" data-kid=\"1-2-8\" id=\"questions\">\n            <div class=\"mx-auto grid max-w-[1100px] gap-10 px-6 lg:grid-cols-[.7fr_1.3fr]\" data-kid=\"1-2-8-1\">\n                <div data-kid=\"1-2-8-1-1\">\n                    <p class=\"lk-kicker mb-4\" data-kid=\"1-2-8-1-1-1\">\n                        Questions de gestion\n                    </p>\n                    <h2 class=\"lk-editorial m-0 max-w-[430px] text-[clamp(2.5rem,4.6vw,4.2rem)] leading-[.98] tracking-[-.04em]\" data-kid=\"1-2-8-1-1-2\">\n                        Les réponses avant la décision.\n                    </h2>\n                    <p class=\"mt-6 max-w-[360px] text-[14px] leading-[1.65] text-[#64635F]\" data-kid=\"1-2-8-1-1-3\">\n                        Tarifs, Mobile Money, loi, diaspora et résiliation : les points qui comptent avant de créer votre premier dossier.\n                    </p>\n                </div>\n                <div data-kid=\"1-2-8-1-2\" data-name=\"faq section container\" id=\"faq-list\">\n                    <div class=\"lk-faq-row\" data-kid=\"1-2-8-1-2-1\">\n                        <button aria-controls=\"faq-1\" aria-expanded=\"true\" class=\"lk-faq-button\" data-kid=\"1-2-8-1-2-1-1\" type=\"button\">\n                            Quelle est la différence entre Découverte, Bailleur Pro et Agence Pro ?\n                            <i aria-hidden=\"true\" class=\"ti ti-minus\" data-kid=\"1-2-8-1-2-1-1-1\">\n                            </i>\n                        </button>\n                        <div class=\"lk-faq-answer\" data-kid=\"1-2-8-1-2-1-2\" id=\"faq-1\">\n                            Découverte est gratuit à vie pour 1 bien avec une gestion basique et des quittances PDF manuelles. Bailleur Pro (5 000 FCFA/mois, jusqu’à 15 biens) débloque le Mobile Money, le portail locataire et la Marketplace Lokka. Agence Pro (25 000 FCFA/mois, 50 biens inclus) ajoute la gestion multi-propriétaires avec mandats, les reversements automatiques, un domaine personnalisé et le SEO/blog.\n                        </div>\n                    </div>\n                    <div class=\"lk-faq-row\" data-kid=\"1-2-8-1-2-2\">\n                        <button aria-controls=\"faq-2\" aria-expanded=\"false\" class=\"lk-faq-button\" data-kid=\"1-2-8-1-2-2-1\" type=\"button\">\n                            Que se passe-t-il si je dépasse le plafond de biens ?\n                            <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-2-8-1-2-2-1-1\">\n                            </i>\n                        </button>\n                        <div class=\"lk-faq-answer\" data-kid=\"1-2-8-1-2-2-2\" hidden=\"\" id=\"faq-2\">\n                            Vous pouvez étendre votre forfait avec un pack additionnel : +5 biens pour 2 000 FCFA/mois en Bailleur Pro (jusqu’à 35 biens max), ou un pack +100 biens pour 5 000 FCFA/mois en Agence Pro. Au-delà, contactez l’équipe Lokka à Cotonou.\n                        </div>\n                    </div>\n                    <div class=\"lk-faq-row\" data-kid=\"1-2-8-1-2-3\">\n                        <button aria-controls=\"faq-3\" aria-expanded=\"false\" class=\"lk-faq-button\" data-kid=\"1-2-8-1-2-3-1\" type=\"button\">\n                            Comment fonctionne l’encaissement Mobile Money ?\n                            <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-2-8-1-2-3-1-1\">\n                            </i>\n                        </button>\n                        <div class=\"lk-faq-answer\" data-kid=\"1-2-8-1-2-3-2\" hidden=\"\" id=\"faq-3\">\n                            Vos locataires peuvent régler leur loyer en FCFA depuis leur téléphone avec MTN MoMo ou Moov Money. Dès que la transaction est confirmée, le tableau de bord s’actualise et la quittance certifiée est générée automatiquement.\n                        </div>\n                    </div>\n                    <div class=\"lk-faq-row\" data-kid=\"1-2-8-1-2-4\">\n                        <button aria-controls=\"faq-4\" aria-expanded=\"false\" class=\"lk-faq-button\" data-kid=\"1-2-8-1-2-4-1\" type=\"button\">\n                            Comment Lokka applique-t-il la Loi n° 2022-30 ?\n                            <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-2-8-1-2-4-1-1\">\n                            </i>\n                        </button>\n                        <div class=\"lk-faq-answer\" data-kid=\"1-2-8-1-2-4-2\" hidden=\"\" id=\"faq-4\">\n                            Lokka intègre la règle de caution maximale de 3 mois, les mentions importantes des quittances et, pour les agences, le plafond de 10% de commission de gestion indiqué dans votre dossier. Les contrôles et leur portée doivent rester clairement documentés dans le produit.\n                        </div>\n                    </div>\n                    <div class=\"lk-faq-row\" data-kid=\"1-2-8-1-2-5\">\n                        <button aria-controls=\"faq-5\" aria-expanded=\"false\" class=\"lk-faq-button\" data-kid=\"1-2-8-1-2-5-1\" type=\"button\">\n                            Mes locataires doivent-ils payer pour utiliser Lokka ?\n                            <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-2-8-1-2-5-1-1\">\n                            </i>\n                        </button>\n                        <div class=\"lk-faq-answer\" data-kid=\"1-2-8-1-2-5-2\" hidden=\"\" id=\"faq-5\">\n                            Non, Lokka est 100% gratuit pour vos locataires. Ils peuvent recevoir leurs rappels et quittances, payer leur loyer et suivre leur bail sans frais supplémentaire.\n                        </div>\n                    </div>\n                    <div class=\"lk-faq-row\" data-kid=\"1-2-8-1-2-6\">\n                        <button aria-controls=\"faq-6\" aria-expanded=\"false\" class=\"lk-faq-button\" data-kid=\"1-2-8-1-2-6-1\" type=\"button\">\n                            Je vis à l’étranger : Lokka est-il adapté à la diaspora ?\n                            <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-2-8-1-2-6-1-1\">\n                            </i>\n                        </button>\n                        <div class=\"lk-faq-answer\" data-kid=\"1-2-8-1-2-6-2\" hidden=\"\" id=\"faq-6\">\n                            Oui. Vous suivez vos loyers à Cotonou avec l’affichage FCFA et le contexte de conversion Euro ou Dollar, recevez les notifications de paiement et retrouvez l’archive de vos documents depuis votre espace.\n                        </div>\n                    </div>\n                    <div class=\"lk-faq-row\" data-kid=\"1-2-8-1-2-7\">\n                        <button aria-controls=\"faq-7\" aria-expanded=\"false\" class=\"lk-faq-button\" data-kid=\"1-2-8-1-2-7-1\" type=\"button\">\n                            Puis-je changer de formule ou annuler à tout moment ?\n                            <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-2-8-1-2-7-1-1\">\n                            </i>\n                        </button>\n                        <div class=\"lk-faq-answer\" data-kid=\"1-2-8-1-2-7-2\" hidden=\"\" id=\"faq-7\">\n                            Oui, les forfaits mensuels sont sans engagement. Vous pouvez passer d’un plan à un autre ou annuler depuis vos paramètres en 1 clic, sans frais de résiliation.\n                        </div>\n                    </div>\n                    <div class=\"lk-faq-row\" data-kid=\"1-2-8-1-2-8\">\n                        <button aria-controls=\"faq-8\" aria-expanded=\"false\" class=\"lk-faq-button\" data-kid=\"1-2-8-1-2-8-1\" type=\"button\">\n                            Comment fonctionne la vitrine et le nom de domaine ?\n                            <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-2-8-1-2-8-1-1\">\n                            </i>\n                        </button>\n                        <div class=\"lk-faq-answer\" data-kid=\"1-2-8-1-2-8-2\" hidden=\"\" id=\"faq-8\">\n                            Les comptes Bailleur Pro et Agence Pro disposent d’un mini-site public comme agence-littoral.lokka.bj. Vous publiez les logements vacants avec leurs photos, loyers, bouton de visite et contact WhatsApp. Agence Pro ajoute le domaine personnalisé et le SEO/blog.\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"relative overflow-hidden border-t border-[#333333] bg-[#18181B] text-white\" data-kid=\"1-2-9\" id=\"final-cta\">\n            <div class=\"lk-quiet-grid pointer-events-none absolute inset-0 opacity-30\" data-kid=\"1-2-9-1\">\n            </div>\n            <div class=\"relative mx-auto grid max-w-[1100px] gap-12 px-6 py-20 sm:py-28 lg:grid-cols-[1fr_390px] lg:items-end\" data-kid=\"1-2-9-2\">\n                <div data-kid=\"1-2-9-2-1\">\n                    <p class=\"lk-kicker mb-5 text-white/55\" data-kid=\"1-2-9-2-1-1\">\n                        Le premier dossier commence ici\n                    </p>\n                    <h2 class=\"lk-editorial m-0 max-w-[650px] text-[clamp(2.8rem,5.2vw,5rem)] leading-[.95] tracking-[-.04em] text-white\" data-kid=\"1-2-9-2-1-2\">\n                        Créez un espace où rien ne se perd.\n                    </h2>\n                    <p class=\"mt-6 max-w-[560px] text-[15px] leading-[1.65] text-white/68\" data-kid=\"1-2-9-2-1-3\">\n                        Baux, encaissements Mobile Money, quittances PDF, portail locataire et logements disponibles : votre prochain état des lieux commence dans Lokka.\n                    </p>\n                </div>\n                <form class=\"border-t border-white/20 pt-6\" data-kid=\"1-2-9-2-2\" data-name=\"final signup form\" id=\"final-form\">\n                    <label class=\"lk-label text-white/65\" data-kid=\"1-2-9-2-2-1\" for=\"final-email\">\n                        Adresse email\n                    </label>\n                    <div class=\"lk-field border-white/25 bg-white\" data-kid=\"1-2-9-2-2-2\">\n                        <input autocomplete=\"email\" data-kid=\"1-2-9-2-2-2-1\" data-name=\"final signup input\" id=\"final-email\" placeholder=\"vous@exemple.com\" required=\"\" type=\"email\"/>\n                        <button class=\"lk-button lk-button-dark shrink-0 border-[#18181B] px-3 text-[11px]\" data-dynamic=\"true\" data-kid=\"1-2-9-2-2-2-2\" data-name=\"final signup button\" data-reason=\"text updated to 'Code envoyé' on form submission\" type=\"submit\">\n                            Créer mon espace\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"1-2-9-2-2-2-2-1\" style=\"width:15px;height:15px;font-size:15px;line-height:15px\">\n                            </i>\n                        </button>\n                    </div>\n                    <p class=\"mt-3 text-[11px] leading-relaxed text-white/55\" data-dynamic=\"true\" data-kid=\"1-2-9-2-2-3\" data-name=\"final signup message\" data-reason=\"text updated to display confirmation on form submission\" id=\"final-message\">\n                        Code de connexion envoyé par email · Sans carte bancaire · Essai gratuit 14 jours\n                    </p>\n                </form>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[#18181B] text-white\" data-kid=\"1-3\">\n        <div class=\"mx-auto flex max-w-[1100px] flex-col gap-7 border-t border-white/10 px-6 py-8 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-3-1\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-3-1-1\">\n                <span class=\"flex h-7 w-7 items-center justify-center rounded-[6px] bg-white text-[#18181B]\" data-kid=\"1-3-1-1-1\">\n                    <svg aria-hidden=\"true\" data-kid=\"1-3-1-1-1-1\" fill=\"none\" height=\"15\" viewbox=\"0 0 500 500\" width=\"15\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M195 87.5 L277 87.5 L231 237.5 L369 237.5 L323 372.5 L141.5 372.5 L180 252.5 L276.5 252.5 L230.5 317.5 L197.5 317.5 L217 252.5 M195 87.5\" fill=\"none\" stroke=\"#18181B\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"16\">\n                        </path>\n                    </svg>\n                </span>\n                <span class=\"lk-editorial text-[21px]\" data-kid=\"1-3-1-1-2\">\n                    Lokka.\n                </span>\n            </div>\n            <div class=\"flex flex-wrap gap-5\" data-kid=\"1-3-1-2\">\n                <a class=\"lk-footer-link\" data-kid=\"1-3-1-2-1\" href=\"#fonctionnement\">\n                    Fonctionnement\n                </a>\n                <a class=\"lk-footer-link\" data-kid=\"1-3-1-2-2\" href=\"#tarifs\">\n                    Tarifs en FCFA\n                </a>\n                <a class=\"lk-footer-link\" data-kid=\"1-3-1-2-3\" href=\"#questions\">\n                    Questions\n                </a>\n                <a class=\"lk-footer-link\" data-kid=\"1-3-1-2-4\" href=\"#signup\">\n                    Créer un compte\n                </a>\n            </div>\n            <span class=\"text-[11px] text-white/40\" data-kid=\"1-3-1-3\">\n                © 2026 Lokka · Bénin\n            </span>\n        </div>\n    </footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n</script>\n<script>\n    (() => {\n  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  const receiptToggle = document.querySelector('#receipt-toggle');\n  const receiptDetail = document.querySelector('#receipt-detail');\n\n  const setReceipt = (open) => {\n    receiptToggle.setAttribute('aria-expanded', String(open));\n    if (open) {\n      receiptDetail.hidden = false;\n      if (reduceMotion) gsap.set(receiptDetail, { autoAlpha: 1, y: 0 });\n      else gsap.fromTo(receiptDetail, { autoAlpha: 0, y: -8 }, { autoAlpha: 1, y: 0, duration: .22, ease: 'power2.out' });\n    } else if (reduceMotion) {\n      receiptDetail.hidden = true;\n    } else {\n      gsap.to(receiptDetail, { autoAlpha: 0, y: -6, duration: .18, ease: 'power2.in', onComplete: () => { receiptDetail.hidden = true; } });\n    }\n  };\n  receiptToggle.addEventListener('click', () => setReceipt(receiptToggle.getAttribute('aria-expanded') !== 'true'));\n\n  document.querySelectorAll('[data-leaf]').forEach((tab) => {\n    tab.addEventListener('click', () => {\n      const key = tab.dataset.leaf;\n      document.querySelectorAll('[data-leaf]').forEach((item) => item.setAttribute('aria-selected', String(item === tab)));\n      document.querySelectorAll('[data-panel]').forEach((panel) => { panel.hidden = panel.dataset.panel !== key; });\n    });\n  });\n\n  const roleData = {\n    bailleur: { heading: 'Votre patrimoine & encaissements', count: '5', oneTitle: 'Loyers encaissés ce mois', oneNote: 'Règlements et quittances de vos logements', oneValue: '1 450 000 FCFA', twoValue: '350 000 FCFA', threeTitle: 'À suivre', threeNote: '1 loyer en retard · relance à envoyer', threeValue: '1 action', note: 'Vous voyez le patrimoine, les loyers et l’action qui mérite votre attention.', detail: 'Le même dossier reste lisible sans passer par une agence tierce.' },\n    agence: { heading: 'Mandats actifs & reversements', count: '24', oneTitle: 'Encaissements des locataires', oneNote: 'Loyers rapprochés sur les biens sous mandat', oneValue: '8 500 000 FCFA', twoValue: '850 000 FCFA', threeTitle: 'Reversements à préparer', threeNote: 'Montant à distribuer aux propriétaires mandants', threeValue: '7 650 000 FCFA', note: 'Vous voyez l’argent encaissé, la commission et ce qui revient à chaque propriétaire.', detail: 'Les propriétaires mandants ne disparaissent pas derrière un total d’agence.' },\n    diaspora: { heading: 'Suivi à distance du patrimoine', count: '6', oneTitle: 'Revenus suivis', oneNote: 'Loyers affichés en FCFA depuis votre espace', oneValue: '1 450 000 FCFA', twoValue: '€ 2 210', threeTitle: 'Documents archivés', threeNote: 'Quittances et baux accessibles à distance', threeValue: '12 fichiers', note: 'Depuis l’étranger, vous gardez la visibilité sur les paiements et les documents.', detail: 'Le contexte FCFA / Euro accompagne le suivi sans remplacer les montants officiels.' }\n  };\n  document.querySelectorAll('[data-role]').forEach((button) => {\n    button.addEventListener('click', () => {\n      const role = button.dataset.role;\n      const data = roleData[role];\n      document.querySelectorAll('[data-role]').forEach((item) => item.setAttribute('aria-selected', String(item === button)));\n      document.querySelector('#role-heading').textContent = data.heading;\n      document.querySelector('#role-count').textContent = data.count;\n      document.querySelector('#role-row-one-title').textContent = data.oneTitle;\n      document.querySelector('#role-row-one-note').textContent = data.oneNote;\n      document.querySelector('#role-row-one-value').textContent = data.oneValue;\n      document.querySelector('#role-row-two-value').textContent = data.twoValue;\n      document.querySelector('#role-row-three-title').textContent = data.threeTitle;\n      document.querySelector('#role-row-three-note').textContent = data.threeNote;\n      document.querySelector('#role-row-three-value').textContent = data.threeValue;\n      document.querySelector('#role-note').textContent = data.note;\n      document.querySelector('#role-note-detail').textContent = data.detail;\n    });\n  });\n\n  const billingToggle = document.querySelector('#billing-toggle');\n  let isAnnual = true;\n  billingToggle.addEventListener('click', () => {\n    isAnnual = !isAnnual;\n    billingToggle.setAttribute('aria-pressed', String(isAnnual));\n    document.querySelector('#billing-knob').style.transform = isAnnual ? 'translateX(24px)' : 'translateX(0)';\n    document.querySelector('#billing-annual-label').style.color = isAnnual ? '#18181B' : '#9B978F';\n    document.querySelector('#billing-monthly-label').style.color = isAnnual ? '#9B978F' : '#18181B';\n    document.querySelectorAll('[data-price-monthly]').forEach((price) => { price.textContent = isAnnual ? price.dataset.priceAnnual : price.dataset.priceMonthly; });\n  });\n\n  document.querySelectorAll('.lk-faq-button').forEach((button) => {\n    button.addEventListener('click', () => {\n      const wasOpen = button.getAttribute('aria-expanded') === 'true';\n      document.querySelectorAll('.lk-faq-button').forEach((item) => {\n        item.setAttribute('aria-expanded', 'false');\n        const icon = item.querySelector('i');\n        icon.className = 'ti ti-plus';\n        icon.style.width = '18px'; icon.style.height = '18px'; icon.style.fontSize = '18px'; icon.style.lineHeight = '18px';\n      });\n      document.querySelectorAll('.lk-faq-answer').forEach((answer) => { answer.hidden = true; });\n      if (!wasOpen) {\n        button.setAttribute('aria-expanded', 'true');\n        button.querySelector('i').className = 'ti ti-minus';\n        document.querySelector('#' + button.getAttribute('aria-controls')).hidden = false;\n      }\n    });\n  });\n\n  const handleForm = (formId, messageId, buttonText) => {\n    const form = document.querySelector(formId);\n    form.addEventListener('submit', (event) => {\n      event.preventDefault();\n      const email = form.querySelector('input').value;\n      document.querySelector(messageId).textContent = 'Code envoyé à ' + email + '. Vérifiez votre boîte de réception pour créer votre espace.';\n      form.querySelector('button').textContent = buttonText;\n    });\n  };\n  handleForm('#signup-form', '#signup-message', 'Code envoyé');\n  handleForm('#final-form', '#final-message', 'Code envoyé');\n\n  const media = gsap.matchMedia();\n  media.add({ reduceMotion: '(prefers-reduced-motion: reduce)' }, ({ conditions }) => {\n    if (conditions.reduceMotion) {\n      gsap.set(['#hero-board', '.lk-reveal', '#proof-line', '#agency-line'], { autoAlpha: 1, y: 0, x: 0, scaleX: 1 });\n      return;\n    }\n    gsap.fromTo('#hero-board', { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: .75, delay: .08, ease: 'power3.out' });\n    gsap.utils.toArray('.lk-reveal').forEach((item) => {\n      gsap.fromTo(item, { autoAlpha: 0, y: 18 }, { autoAlpha: 1, y: 0, duration: .55, ease: 'power3.out', scrollTrigger: { trigger: item, start: 'top 84%', once: true } });\n    });\n    gsap.fromTo('#proof-line', { scaleX: 0 }, { scaleX: 1, duration: 1.05, ease: 'power2.inOut', scrollTrigger: { trigger: '#payment-proof', start: 'top 72%', once: true } });\n    gsap.fromTo('#agency-line', { scaleX: 0 }, { scaleX: 1, duration: .9, ease: 'power2.inOut', scrollTrigger: { trigger: '#agence-file', start: 'top 70%', once: true } });\n    gsap.fromTo('.lk-quote', { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: .5, stagger: .08, ease: 'power3.out', scrollTrigger: { trigger: '.lk-quote', start: 'top 82%', once: true } });\n    gsap.fromTo('#tarifs .lk-table-wrap', { autoAlpha: 0, y: 18 }, { autoAlpha: 1, y: 0, duration: .6, ease: 'power3.out', scrollTrigger: { trigger: '#tarifs', start: 'top 76%', once: true } });\n  });\n})();\n</script>\n",
      "comments": [],
      "created": "2026-08-31T05:03:04.190081+00:00",
      "modified": "2026-08-31T05:05:38.007702+00:00",
