                          <i class=\"ti ti-check icon\" data-kid=\"1-2-7-1-3-1-2-4-4-1\" style=\"color:#087F5B;width:16px;height:16px\">\n                                    </i>\n                                </td>\n                            </tr>\n                            <tr class=\"bg-[#F4F2EC]\" data-kid=\"1-2-7-1-3-1-2-5\">\n                                <th class=\"px-5 py-3 text-[11px] font-semibold uppercase tracking-[0.13em] text-[#71717A] sm:px-7\" colspan=\"4\" data-kid=\"1-2-7-1-3-1-2-5-1\">\n                                    Encaisser & remettre les documents\n                                </th>\n                            </tr>\n                            <tr class=\"border-t border-[#E4E0D8]\" data-kid=\"1-2-7-1-3-1-2-6\">\n                                <td class=\"px-5 py-4 text-[#18181B] sm:px-7\" data-kid=\"1-2-7-1-3-1-2-6-1\">\n                                    Paiements & quittances PDF manuels\n                                </td>\n                                <td class=\"border-l border-[#E4E0D8] px-5 py-4 text-[#087F5B] sm:px-6\" data-kid=\"1-2-7-1-3-1-2-6-2\">\n                                    <i class=\"ti ti-check icon\" data-kid=\"1-2-7-1-3-1-2-6-2-1\" style=\"color:#087F5B;width:16px;height:16px\">\n                                    </i>\n                                </td>\n                                <td class=\"border-l border-[#E4E0D8] px-5 py-4 text-[#A1A1AA] sm:px-6\" data-kid=\"1-2-7-1-3-1-2-6-3\">\n                                    —\n                                </td>\n                                <td class=\"border-l border-[#E4E0D8] px-5 py-4 text-[#A1A1AA] sm:px-6\" data-kid=\"1-2-7-1-3-1-2-6-4\">\n                                    —\n                                </td>\n                            </tr>\n                            <tr class=\"border-t border-[#E4E0D8]\" data-kid=\"1-2-7-1-3-1-2-7\">\n                                <td class=\"px-5 py-4 text-[#18181B] sm:px-7\" 