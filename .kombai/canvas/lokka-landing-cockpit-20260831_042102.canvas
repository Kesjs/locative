    "var_6f2aa2be95a5": {
      "type": "variant",
      "label": "Lokka — Cockpit lumineux 3D",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n.lokka-luminous {\n  --canvas: #FAF9F6;\n  --paper: #FFFFFF;\n  --ink: #18181B;\n  --ink-soft: #52525B;\n  --muted: #71717A;\n  --line: #E4E0D8;\n  --line-strong: #D1CBBF;\n  --green: #087F5B;\n  --green-soft: #E6F5EF;\n  --amber: #B45309;\n  --amber-soft: #FFF3D6;\n  --red: #C92A2A;\n  --serif: 'Instrument Serif', Georgia, serif;\n  --sans: 'Inter', system-ui, sans-serif;\n  min-height: 100vh;\n  overflow-x: hidden;\n  color: var(--ink);\n  background: var(--canvas);\n  font-family: var(--sans);\n  letter-spacing: -0.012em;\n}\n.lokka-luminous .serif { font-family: var(--serif); }\n.lokka-luminous .tabular { font-variant-numeric: tabular-nums; letter-spacing: -0.035em; }\n.lokka-luminous .icon { display: inline-flex; width: 16px; height: 16px; flex: 0 0 16px; line-height: 16px; align-items: center; justify-content: center; }\n.lokka-luminous .hairline { border-color: var(--line); }\n.lokka-luminous .quiet-grid {\n  background-image: linear-gradient(rgba(24,24,27,.055) 1px, transparent 1px), linear-gradient(90deg, rgba(24,24,27,.055) 1px, transparent 1px);\n  background-size: 40px 40px;\n}\n.lokka-luminous .hero-scene {\n  background-color: var(--canvas);\n  background-image: radial-gradient(circle at 77% 12%, rgba(8,127,91,.12), transparent 22rem), radial-gradient(circle at 18% 20%, rgba(255,255,255,.92), transparent 22rem), linear-gradient(180deg, rgba(255,255,255,.28), transparent 45%);\n}\n.lokka-luminous .hero-glow {\n  border: 1px solid rgba(8,127,91,.1);\n  box-shadow: 0 0 0 18px rgba(8,127,91,.025), 0 0 0 42px rgba(8,127,91,.018);\n}\n.lokka-luminous .dashboard-stage { perspective: 1500px; }\n.lokka-luminous .dashboard-card {\n  position: relative;\n  transform-style: preserve-3d;\n  transform: rotateX(8deg) rotateY(-5deg) rotateZ(.2deg);\n  box-shadow: 28px 32px 0 rgba(24,24,27,.045), 0 42px 90px rgba(24,24,27,.16), 0 8px 20px rgba(24,24,27,.08);\n  will-change: transform, opacity;\n}\n.lokka-luminous .dashboard-card::before {\n  content: '';\n  position: absolute;\n  z-index: -1;\n  top: 14px;\n  right: -18px;\n  bottom: -12px;\n  width: 18px;\n  border-right: 1px solid rgba(24,24,27,.16);\n  background: linear-gradient(180deg, #D8D3C8, #BFB9AF);\n  transform: translateZ(-4px) skewY(-33deg);\n  transform-origin: left top;\n}\n.lokka-luminous .dashboard-card::after {\n  content: '';\n  position: absolute;\n  z-index: -2;\n  right: 34px;\n  bottom: -32px;\n  left: 34px;\n  height: 34px;\n  background: rgba(24,24,27,.12);\n  filter: blur(24px);\n  transform: translateZ(-20px) rotateX(70deg);\n}\n.lokka-luminous .dash-face { transform-style: preserve-3d; }\n.lokka-luminous .dash-nav { transform: translateZ(16px); }\n.lokka-luminous .dash-main { transform: translateZ(20px); }\n.lokka-luminous .dash-rail { transform: translateZ(13px); }\n.lokka-luminous .dash-panel { transform: translateZ(9px); }\n.lokka-luminous .dash-row { transform: translateZ(12px); }\n.lokka-luminous .dash-view { display: none; }\n.lokka-luminous .dash-view.is-active { display: block; }\n.lokka-luminous .dashboard-tab[aria-selected='true'] { background: var(--ink); color: #fff; }\n.lokka-luminous .dashboard-tab[aria-selected='false'] { color: var(--muted); }\n.lokka-luminous .dashboard-tab[aria-selected='false']:hover { color: var(--ink); background: #F4F2EC; }\n.lokka-luminous .transaction-row { cursor: pointer; }\n.lokka-luminous .transaction-row:hover { background: #F4F2EC; }\n.lokka-luminous .transaction-row.is-selected { background: var(--green-soft); }\n.lokka-luminous .receipt-drawer { display: grid; grid-template-rows: 0fr; overflow: hidden; }\n.lokka-luminous .receipt-drawer.is-open { grid-template-rows: 1fr; }\n.lokka-luminous .receipt-drawer > div { min-height: 0; overflow: hidden; }\n.lokka-luminous .receipt-qr {\n  background-image: linear-gradient(90deg, var(--ink) 22%, transparent 22%, transparent 44%, var(--ink) 44%, var(--ink) 61%, transparent 61%), linear-gradient(var(--ink) 22%, transparent 22%, transparent 44%, var(--ink) 44%, var(--ink) 61%, transparent 61%);\n  background-size: 9px 9px;\n  border: 5px solid white;\n  box-shadow: 0 0 0 1px var(--line-strong);\n}\n.lokka-luminous .meter-fill { width: 90%; background: var(--green); }\n.lokka-luminous .feature-line:hover { background: rgba(255,255,255,.82); }\n.lokka-luminous .feature-line:hover .feature-arrow { transform: translateX(4px); }\n.lokka-luminous .feature-arrow { display: inline-flex; }\n.lokka-luminous .publish-state { display: none; }\n.lokka-luminous .publish-state.is-visible { display: flex; }\n.lokka-luminous .listing-switch[aria-pressed='true'] .switch-thumb { transform: translateX(20px); }\n.lokka-luminous .switch-thumb { transform: translateX(0); }\n.lokka-luminous .price-cell[data-current='true'] { background: #F2F8F5; border-top: 2px solid var(--green); }\n.lokka-luminous .price-value[data-annual='true'] { display: inline; }\n.lokka-luminous .price-value[data-annual='false'] { display: none; }\n.lokka-luminous .billing-copy[data-annual='true'] { display: inline; }\n.lokka-luminous .billing-copy[data-annual='false'] { display: none; }\n.lokka-luminous .faq-answer { max-height: 0; overflow: hidden; opacity: 0; }\n.lokka-luminous details[open] .faq-answer { max-height: 20rem; opacity: 1; }\n.lokka-luminous details[open] .faq-chevron { transform: rotate(180deg); }\n.lokka-luminous .faq-chevron { display: inline-flex; }\n.lokka-luminous .form-feedback { min-height: 18px; }\n.lokka-luminous .testimonial-note { border-left: 2px solid var(--line-strong); }\n.lokka-luminous .testimonial-note:hover { border-left-color: var(--green); }\n.lokka-luminous .footer-link:hover { color: #fff; }\n@media (max-width: 899px) {\n  .lokka-luminous .dashboard-card { transform: none; box-shadow: 0 22px 50px rgba(24,24,27,.13), 0 6px 18px rgba(24,24,27,.06); }\n  .lokka-luminous .dashboard-card::before, .lokka-luminous .dashboard-card::after { display: none; }\n  .lokka-luminous .dash-nav { transform: none; }\n  .lokka-luminous .dash-main, .lokka-luminous .dash-rail, .lokka-luminous .dash-panel, .lokka-luminous .dash-row { transform: none; }\n}\n@media (prefers-reduced-motion: reduce) {\n  .lokka-luminous html { scroll-behavior: auto; }\n}\n</style>\n<div class=\"lokka-luminous\" data-kid=\"1\" data-lokka-root=\"\">\n    <header class=\"relative z-30 border-b border-[#E4E0D8] bg-[#FAF9F6]/90 backdrop-blur-md\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex max-w-[1240px] items-center justify-between px-5 py-4 sm:px-8 lg:px-10\" data-kid=\"1-1-1\">\n            <button aria-label=\"Retour en haut\" class=\"flex items-center gap-3 text-left\" data-kid=\"1-1-1-1\" data-scroll=\"#top\" type=\"button\">\n                <span aria-hidden=\"true\" class=\"flex h-9 w-9 items-center justify-center rounded-[8px] bg-[#18181B]\" data-kid=\"1-1-1-1-1\">\n                    <svg data-kid=\"1-1-1-1-1-1\" fill=\"none\" height=\"20\" viewbox=\"0 0 500 500\" width=\"20\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M195 87.5 L277 87.5 L231 237.5 L369 237.5 L323 372.5 L141.5 372.5 L180 252.5 L276.5 252.5 L230.5 317.5 L197.5 317.5 L217 252.5 M195 87.5\" stroke=\"#FFFFFF\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"16\">\n                        </path>\n                    </svg>\n                </span>\n                <span class=\"serif text-[25px] leading-none tracking-tight\" data-kid=\"1-1-1-1-2\">\n                    Lokka.\n                </span>\n            </button>\n            <nav aria-label=\"Navigation principale\" class=\"hidden items-center gap-7 text-[13px] font-medium text-[#52525B] lg:flex\" data-kid=\"1-1-1-2\">\n                <button class=\"hover:text-[#18181B]\" data-kid=\"1-1-1-2-1\" data-scroll=\"#automation\" type=\"button\">\n                    Fonctionnalités\n                </button>\n                <button class=\"hover:text-[#18181B]\" data-kid=\"1-1-1-2-2\" data-scroll=\"#workflow\" type=\"button\">\n                    Fonctionnement\n                </button>\n                <button class=\"hover:text-[#18181B]\" data-kid=\"1-1-1-2-3\" data-scroll=\"#pricing\" type=\"button\">\n                    Tarifs\n                </button>\n                <button class=\"hover:text-[#18181B]\" data-kid=\"1-1-1-2-4\" data-scroll=\"#faq\" type=\"button\">\n                    Questions\n                </button>\n            </nav>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-3\">\n                <span class=\"hidden text-[12px] text-[#71717A] sm:inline\" data-kid=\"1-1-1-3-1\">\n                    Bénin · Diaspora\n                </span>\n                <button class=\"inline-flex min-h-[40px] items-center gap-2 rounded-[6px] bg-[#18181B] px-4 text-[13px] font-semibold text-white hover:bg-[#087F5B]\" data-kid=\"1-1-1-3-2\" data-scroll=\"#final-cta\" type=\"button\">\n                    Créer mon espace\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right icon\" data-kid=\"1-1-1-3-2-1\" style=\"color:#FFFFFF;width:16px;height:16px\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" id=\"top\">\n        <section class=\"hero-scene relative overflow-hidden border-b border-[#E4E0D8] px-5 pb-20 pt-20 sm:px-8 sm:pb-28 sm:pt-28 lg:px-10 lg:pt-32\" data-kid=\"1-2-1\">\n            <div aria-hidden=\"true\" class=\"pointer-events-none absolute -right-20 top-24 h-[420px] w-[420px] rounded-full border border-[#087F5B]/10 opacity-80 sm:right-[8%] sm:top-28\" data-kid=\"1-2-1-1\">\n            </div>\n            <div aria-hidden=\"true\" class=\"hero-glow pointer-events-none absolute right-[18%] top-40 h-3 w-3 rounded-full bg-[#087F5B]/60\" data-kid=\"1-2-1-2\">\n            </div>\n            <div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-x-0 top-0 h-[46%] opacity-30 quiet-grid [mask-image:linear-gradient(to_bottom,black,transparent)]\" data-kid=\"1-2-1-3\">\n            </div>\n            <div class=\"relative z-10 mx-auto max-w-[1120px] text-center\" data-kid=\"1-2-1-4\">\n                <div class=\"hero-kicker mb-6 inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.17em] text-[#087F5B]\" data-kid=\"1-2-1-4-1\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#087F5B]\" data-kid=\"1-2-1-4-1-1\">\n                    </span>\n                    Gestion locative au Bénin et dans la diaspora\n                </div>\n                <h1 class=\"hero-title mx-auto max-w-[840px] text-[clamp(2.8rem,7vw,6.6rem)] font-semibold leading-[.94] tracking-[-0.075em] text-[#18181B]\" data-kid=\"1-2-1-4-2\">\n                    Votre patrimoine locatif\n                    <br data-kid=\"1-2-1-4-2-1\"/>\n                    <span class=\"serif font-normal italic tracking-[-0.055em] text-[#52525B]\" data-kid=\"1-2-1-4-2-2\">\n                        Enfin sous contrôle\n                    </span>\n                </h1>\n                <p class=\"hero-copy mx-auto mt-7 max-w-[650px] text-[15px] leading-[1.75] text-[#52525B] sm:text-[17px]\" data-kid=\"1-2-1-4-3\">\n                    Que vous soyez au Bénin ou dans la diaspora, gérez vos logements, vos quittances officielles et votre site vitrine depuis un seul espace.\n                </p>\n                <form class=\"hero-form mx-auto mt-8 max-w-[480px] text-left\" data-kid=\"1-2-1-4-4\" data-signup-form=\"\">\n                    <label class=\"mb-2 block text-[12px] font-semibold text-[#18181B]\" data-kid=\"1-2-1-4-4-1\" for=\"hero-email-luminous\">\n                        Votre adresse email\n                    </label>\n                    <div class=\"flex flex-col gap-2 sm:flex-row\" data-kid=\"1-2-1-4-4-2\">\n                        <input class=\"min-h-[48px] min-w-0 flex-1 rounded-[6px] border border-[#D1CBBF] bg-white px-4 text-[14px] text-[#18181B] outline-none placeholder:text-[#A1A1AA] focus:border-[#18181B] focus:ring-2 focus:ring-[#18181B]/10\" data-email=\"\" data-kid=\"1-2-1-4-4-2-1\" data-name=\"email input field\" id=\"hero-email-luminous\" placeholder=\"Votre adresse email\" required=\"\" type=\"email\"/>\n                        <button class=\"inline-flex min-h-[48px] items-center justify-center gap-2 rounded-[6px] bg-[#18181B] px-6 text-[13px] font-semibold text-white hover:bg-[#087F5B]\" data-kid=\"1-2-1-4-4-2-2\" data-submit-button=\"\" type=\"submit\">\n                            <span data-kid=\"1-2-1-4-4-2-2-1\" data-submit-label=\"\">\n                                Commencer\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-right icon\" data-kid=\"1-2-1-4-4-2-2-2\" style=\"color:#FFFFFF;width:16px;height:16px\">\n                            </i>\n                        </button>\n                    </div>\n                    <p aria-live=\"polite\" class=\"form-feedback mt-3 text-[12px] leading-relaxed text-[#71717A]\" data-dynamic=\"true\" data-feedback=\"\" data-kid=\"1-2-1-4-4-3\" data-name=\"form feedback message\" data-reason=\"text updated to confirmation message by script\">\n                        Créez votre espace en quelques secondes. Essai gratuit 14 jours.\n                    </p>\n                </form>\n                <div class=\"hero-proof mt-7 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[12px] font-medium text-[#52525B] sm:text-[13px]\" data-kid=\"1-2-1-4-5\">\n                    <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-4-5-1\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#087F5B]\" data-kid=\"1-2-1-4-5-1-1\">\n                        </span>\n            