      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n.lk-shell {\n  --lk-canvas: #FAF9F6;\n  --lk-paper: #FFFFFF;\n  --lk-ink: #18181B;\n  --lk-muted: #64635F;\n  --lk-soft: #F4F2EC;\n  --lk-line: #E4E0D8;\n  --lk-line-soft: #F0EDE6;\n  --lk-green: #087F5B;\n  --lk-green-bg: #E6F5EF;\n  --lk-amber: #A15C00;\n  --lk-amber-bg: #FFF5DE;\n  --lk-red: #B42318;\n  --lk-red-bg: #FDEBE8;\n  font-family: 'Inter', system-ui, sans-serif;\n  color: var(--lk-ink);\n  background: var(--lk-canvas);\n  min-height: 100vh;\n}\n.lk-shell .lk-editorial { font-family: 'Instrument Serif', Georgia, serif; }\n.lk-shell .lk-grid-paper {\n  background-image: linear-gradient(rgba(24,24,27,.055) 1px, transparent 1px), linear-gradient(90deg, rgba(24,24,27,.055) 1px, transparent 1px);\n  background-size: 34px 34px;\n  mask-image: linear-gradient(90deg, transparent 0%, black 42%, black 100%);\n  opacity: .34;\n}\n.lk-shell .lk-sheet { background: var(--lk-paper); border: 1px solid var(--lk-line); border-radius: 10px; }\n.lk-shell .lk-sheet-flat { background: var(--lk-paper); border-top: 1px solid var(--lk-line); border-bottom: 1px solid var(--lk-line); }\n.lk-shell .lk-rule { border-top: 1px solid var(--lk-line); }\n.lk-shell .lk-rule-soft { border-top: 1px solid var(--lk-line-soft); }\n.lk-shell .lk-mono { font-variant-numeric: tabular-nums; font-feature-settings: 'tnum' 1, 'zero' 1; }\n.lk-shell .lk-kicker { color: var(--lk-muted); font-size: 10px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }\n.lk-shell .lk-note { color: var(--lk-muted); font-size: 12px; line-height: 1.55; }\n.lk-shell .lk-status { display: inline-flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 700; letter-spacing: .02em; }\n.lk-shell .lk-status-dot { width: 7px; height: 7px; border-radius: 999px; flex: 0 0 auto; }\n.lk-shell .lk-status-dot-green { background: var(--lk-green); }\n.lk-shell .lk-status-dot-amber { background: var(--lk-amber); }\n.lk-shell .lk-status-dot-red { background: var(--lk-red); }\n.lk-shell .lk-button { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 42px; border-radius: 6px; border: 1px solid var(--lk-ink); padding: 0 16px; font-size: 13px; font-weight: 700; cursor: pointer; }\n.lk-shell .lk-button-dark { background: var(--lk-ink); color: #fff; }\n.lk-shell .lk-button-dark:hover { background: #34343A; }\n.lk-shell .lk-button-light { background: var(--lk-paper); color: var(--lk-ink); border-color: var(--lk-line); }\n.lk-shell .lk-button-light:hover { border-color: var(--lk-ink); }\n.lk-shell .lk-link { color: var(--lk-ink); text-decoration: underline; text-decoration-color: #B7B1A5; text-underline-offset: 4px; cursor: pointer; }\n.lk-shell .lk-link:hover { text-decoration-color: var(--lk-ink); }\n.lk-shell .lk-field { display: flex; align-items: stretch; border: 1px solid var(--lk-line); border-radius: 7px; background: var(--lk-paper); padding: 5px; }\n.lk-shell .lk-field:focus-within { border-color: var(--lk-ink); outline: 2px solid rgba(8,127,91,.16); outline-offset: 2px; }\n.lk-shell .lk-field input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; padding: 0 11px; color: var(--lk-ink); font: 500 13px/1.2 'Inter', sans-serif; }\n.lk-shell .lk-field input::placeholder { color: #9B978F; }\n.lk-shell .lk-label { display: block; margin-bottom: 7px; color: var(--lk-muted); font-size: 11px; font-weight: 700; }\n.lk-shell .lk-index { border-right: 1px solid var(--lk-line); padding-right: 24px; }\n.lk-shell .lk-index-link { display: flex; gap: 10px; align-items: baseline; color: #8B877F; font-size: 12px; line-height: 1.25; text-decoration: none; padding: 8px 0; }\n.lk-shell .lk-index-link span { color: #B0AAA0; font-size: 10px; font-variant-numeric: tabular-nums; }\n.lk-shell .lk-index-link.is-current { color: var(--lk-ink); font-weight: 700; }\n.lk-shell .lk-index-link.is-current span { color: var(--lk-green); }\n.lk-shell .lk-index-link:hover { color: var(--lk-ink); }\n.lk-shell .lk-value { color: var(--lk-ink); font-size: 20px; font-weight: 700; letter-spacing: -.035em; line-height: 1.1; }\n.lk-shell .lk-value-sm { color: var(--lk-ink); font-size: 16px; font-weight: 700; letter-spacing: -.025em; line-height: 1.2; }\n.lk-shell .lk-record-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 18px; align-items: center; padding: 15px 0; }\n.lk-shell .lk-record-row + .lk-record-row { border-top: 1px solid var(--lk-line-soft); }\n.lk-shell .lk-record-meta { color: var(--lk-muted); font-size: 11px; line-height: 1.45; }\n.lk-shell .lk-record-title { color: var(--lk-ink); font-size: 13px; font-weight: 700; line-height: 1.35; }\n.lk-shell .lk-qr { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border: 1px solid var(--lk-line); border-radius: 5px; color: var(--lk-ink); background: var(--lk-soft); }\n.lk-shell .lk-qr i { width: 20px; height: 20px; font-size: 20px; line-height: 20px; }\n.lk-shell .lk-proof-track { height: 1px; width: 100%; background: var(--lk-line); overflow: hidden; }\n.lk-shell .lk-proof-progress { height: 1px; width: 100%; background: var(--lk-green); transform-origin: left center; transform: scaleX(0); }\n.lk-shell .lk-tabs { display: flex; flex-wrap: wrap; gap: 4px; border-bottom: 1px solid var(--lk-line); }\n.lk-shell .lk-tab { min-height: 42px; border: 0; border-bottom: 2px solid transparent; padding: 0 12px; background: transparent; color: var(--lk-muted); font-size: 12px; font-weight: 700; cursor: pointer; }\n.lk-shell .lk-tab[aria-selected='true'] { border-bottom-color: var(--lk-green); color: var(--lk-ink); }\n.lk-shell .lk-panel[hidden] { display: none; }\n.lk-shell .lk-panel { padding-top: 24px; }\n.lk-shell .lk-stamp { display: inline-flex; align-items: center; gap: 7px; border: 1px solid var(--lk-green); color: var(--lk-green); border-radius: 4px; padding: 5px 8px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; transform: rotate(-1.2deg); }\n.lk-shell .lk-stamp i { font-size: 14px; width: 14px; height: 14px; line-height: 14px; }\n.lk-shell .lk-role-switch { display: inline-flex; align-items: center; gap: 3px; border: 1px solid var(--lk-line); border-radius: 7px; padding: 3px; background: var(--lk-paper); }\n.lk-shell .lk-role-switch button { min-height: 34px; border: 0; border-radius: 4px; padding: 0 12px; background: transparent; color: var(--lk-muted); font-size: 11px; font-weight: 700; cursor: pointer; }\n.lk-shell .lk-role-switch button[aria-selected='true'] { background: var(--lk-ink); color: #fff; }\n.lk-shell .lk-connector { position: relative; height: 1px; background: var(--lk-line); }\n.lk-shell .lk-connector-fill { position: absolute; inset: 0 auto 0 0; width: 100%; background: var(--lk-green); transform: scaleX(0); transform-origin: left center; }\n.lk-shell .lk-faq-row { border-top: 1px solid var(--lk-line); }\n.lk-shell .lk-faq-row:last-child { border-bottom: 1px solid var(--lk-line); }\n.lk-shell .lk-faq-button { display: flex; align-items: center; justify-content: space-between; gap: 20px; width: 100%; min-height: 62px; border: 0; background: transparent; color: var(--lk-ink); text-align: left; font-size: 14px; font-weight: 700; cursor: pointer; }\n.lk-shell .lk-faq-button i { width: 18px; height: 18px; font-size: 18px; line-height: 18px; color: var(--lk-muted); }\n.lk-shell .lk-faq-answer { padding: 0 40px 20px 0; color: var(--lk-muted); font-size: 13px; line-height: 1.65; max-width: 760px; }\n.lk-shell .lk-faq-answer[hidden] { display: none; }\n.lk-shell .lk-table { width: 100%; border-collapse: collapse; font-size: 12px; }\n.lk-shell .lk-table th, .lk-shell .lk-table td { border-bottom: 1px solid var(--lk-line-soft); padding: 13px 12px; vertical-align: middle; }\n.lk-shell .lk-table th { color: var(--lk-ink); font-size: 11px; text-align: center; background: var(--lk-soft); }\n.lk-shell .lk-table th:first-child { text-align: left; min-width: 260px; }\n.lk-shell .lk-table td:first-child { color: var(--lk-ink); font-weight: 600; }\n.lk-shell .lk-table td:not(:first-child) { text-align: center; color: var(--lk-muted); }\n.lk-shell .lk-table .lk-plan-focus { background: rgba(8,127,91,.045); }\n.lk-shell .lk-table .lk-group td { padding-top: 22px; padding-bottom: 8px; border-bottom: 0; color: var(--lk-green); font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }\n.lk-shell .lk-check { color: var(--lk-green); font-size: 16px; width: 16px; height: 16px; line-height: 16px; }\n.lk-shell .lk-minus { color: #AAA59B; font-size: 16px; width: 16px; height: 16px; line-height: 16px; }\n.lk-shell .lk-quote { border-left: 2px solid var(--lk-green); padding-left: 16px; }\n.lk-shell .lk-quote p { margin: 0; color: var(--lk-ink); font-family: 'Instrument Serif', Georgia, serif; font-size: 21px; line-height: 1.18; }\n.lk-shell .lk-quote cite { display: block; margin-top: 14px; color: var(--lk-muted); font-size: 11px; font-style: normal; line-height: 1.45; }\n.lk-shell .lk-reveal { opacity: 1; transform: translateY(0); }\n.lk-shell .lk-section-space { padding-top: 112px; padding-bottom: 112px; }\n.lk-shell .lk-legal-note { border-left: 2px solid var(--lk-ink); padding-left: 16px; }\n.lk-shell .lk-metric-slot { padding: 16px 18px; border-left: 1px solid var(--lk-line); }\n.lk-shell .lk-metric-slot:first-child { border-left: 0; padding-left: 0; }\n.lk-shell .lk-metric-label { color: var(--lk-muted); font-size: 10px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }\n.lk-shell .lk-mini-status { display: inline-flex; align-items: center; gap: 6px; color: var(--lk-muted); font-size: 11px; }\n.lk-shell .lk-mini-status i { width: 13px; height: 13px; font-size: 13px; line-height: 13px; color: var(--lk-green); }\n.lk-shell .lk-drawer { border-top: 1px solid var(--lk-line); margin-top: 13px; padding-top: 14px; }\n.lk-shell .lk-drawer[hidden] { display: none; }\n.lk-shell .lk-quiet-grid { background-image: linear-gradient(rgba(24,24,27,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(24,24,27,.04) 1px, transparent 1px); background-size: 34px 34px; }\n.lk-shell .lk-footer-link { color: rgba(255,255,255,.62); font-size: 12px; text-decoration: none; }\n.lk-shell .lk-footer-link:hover { color: #fff; }\n@media (max-width: 1020px) {\n  .lk-shell .lk-index { display: none; }\n  .lk-shell .lk-main-grid { display: block; }\n  .lk-shell .lk-hero-grid { display: block; }\n  .lk-shell .lk-hero-rail { margin-top: 28px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; }\n  .lk-shell .lk-hero-signup { grid-column: 1 / -1; margin-top: 26px; }\n}\n@media (max-width: 700px) {\n  .lk-shell .lk-section-space { padding-top: 72px; padding-bottom: 72px; }\n  .lk-shell .lk-hero-rail { display: block; }\n  .lk-shell .lk-metric-slot, .lk-shell .lk-metric-slot:first-child { border-left: 0; border-top: 1px solid var(--lk-line); padding: 14px 0; }\n  .lk-shell .lk-record-row { grid-template-columns: 1fr; gap: 10px; }\n  .lk-shell .lk-record-row .lk-record-action { justify-self: start; }\n  .lk-shell .lk-table-wrap { overflow-x: auto; border-left: 1px solid var(--lk-line); border-right: 1px solid var(--lk-line); }\n  .lk-shell .lk-table { min-width: 720px; }\n  .lk-shell .lk-quote p { font-size: 19px; }\n  .lk-shell .lk-nav-links { display: none; }\n  .lk-shell .lk-nav-inner { padding-left: 16px; padding-right: 16px; }\n  .lk-shell .lk-hero-title { font-size: 42px; }\n}\n</style>\n<div class=\"lk-shell m-0 min-h-screen overflow-hidden\" data-kid=\"1\">\n    <header class=\"relative z-30 border-b border-[#E4E0D8] bg-[#FAF9F6]\" data-kid=\"1-1\">\n        <div class=\"lk-nav-inner mx-auto flex max-w-[1240px] items-center justify-between px-6 py-4\" data-kid=\"1-1-1\">\n            <a aria-label=\"Lokka, accueil\" class=\"flex items-center gap-3 no-underline\" data-kid=\"1-1-1-1\" href=\"#top\">\n                <span class=\"flex h-8 w-8 items-center justify-center rounded-[7px] bg-[#18181B] text-white\" data-kid=\"1-1-1-1-1\">\n                    <svg aria-hidden=\"true\" data-kid=\"1-1-1-1-1-1\" fill=\"none\" height=\"18\" viewbox=\"0 0 500 500\" width=\"18\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M195 87.5 L277 87.5 L231 237.5 L369 237.5 L323 372.5 L141.5 372.5 L180 252.5 L276.5 252.5 L230.5 317.5 L197.5 317.5 L217 252.5 M195 87.5\" fill=\"none\" stroke=\"#FFFFFF\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"16\">\n                        </path>\n                    </svg>\n                </span>\n                <span class=\"lk-editorial text-[25px] leading-none text-[#18181B]\" data-kid=\"1-1-1-1-2\">\n                    Lokka.\n                </span>\n            </a>\n            <nav aria-label=\"Navigation principale\" class=\"lk-nav-links flex items-center gap-7\" data-kid=\"1-1-1-2\">\n                <a class=\"text-[12px] font-semibold text-[#64635F] no-underline hover:text-[#18181B]\" data-kid=\"1-1-1-2-1\" href=\"#fonctionnement\">\n                    Fonctionnement\n                </a>\n                <a class=\"text-[12px] font-semibold text-[#64635F] no-underline hover:text-[#18181B]\" data-kid=\"1-1-1-2-2\" href=\"#agence-file\">\n                    Pour les agences\n                </a>\n                <a class=\"text-[12px] font-semibold text-[#64635F] no-underline hover:text-[#18181B]\" data-kid=\"1-1-1-2-3\" href=\"#tarifs\">\n                    Tarifs\n                </a>\n                <a class=\"text-[12px] font-semibold text-[#64635F] no-underline hover:text-[#18181B]\" data-kid=\"1-1-1-2-4\" href=\"#questions\">\n                    Questions\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-1-3\">\n                <a class=\"hidden text-[12px] font-semibold text-[#18181B] no-underline sm:inline\" data-kid=\"1-1-1-3-1\" href=\"#signup\">\n                    Connexion\n                </a>\n                <a class=\"lk-button lk-button-dark no-underline\" data-kid=\"1-1-1-3-2\" href=\"#signup\">\n                    Créer mon espace\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"1-1-1-3-2-1\" style=\"width:15px;height:15px;font-size:15px;line-height:15px\">\n                    </i>\n                </a>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\">\n        <section class=\"relative border-b border-[#E4E0D8]\" data-kid=\"1-2-1\" id=\"top\">\n            <div class=\"lk-grid-paper pointer-events-none absolute inset-y-0 right-0 hidden w-[54%] lg:block\" data-kid=\"1-2-1-1\">\n            </div>\n            <div class=\"lk-main-grid relative mx-auto grid max-w-[1240px] grid-cols-[150px_minmax(0,1fr)] gap-10 px-6 py-16 sm:py-20 lg:grid-cols-[150px_minmax(0,1fr)_260px] lg:gap-12 lg:py-24\" data-kid=\"1-2-1-2\">\n                <aside aria-label=\"Index de la landing page\" class=\"lk-index hidden lg:block\" data-kid=\"1-2-1-2-1\">\n                    <div class=\"lk-kicker mb-5\" data-kid=\"1-2-1-2-1-1\">\n                        Registre Lokka\n                    </div>\n                    <a class=\"lk-index-link is-current\" data-kid=\"1-2-1-2-1-2\" href=\"#top\">\n                        <span data-kid=\"1-2-1-2-1-2-1\">\n                            01\n                        </span>\n                        Aperçu du patrimoine\n                    </a>\n                    <a class=\"lk-index-link\" data-kid=\"1-2-1-2-1-3\" href=\"#fonctionnement\">\n                        <span data-kid=\"1-2-1-2-1-3-1\">\n                            02\n                        </span>\n                        Dossier de location\n                    </a>\n                    <a class=\"lk-index-link\" data-kid=\"1-2-1-2-1-4\" href=\"#agence-file\">\n                        <span data-kid=\"1-2-1-2-1-4-1\">\n                            03\n                        </span>\n                        Mandats & reversements\n                    </a>\n                    <a class=\"lk-index-link\" data-kid=\"1-2-1-2-1-5\" href=\"#vitrine\">\n                        <span data-kid=\"1-2-1-2-1-5-1\">\n                            04\n                        </span>\n                        Biens à publier\n                    </a>\n                    <a class=\"lk-index-link\" data-kid=\"1-2-1-2-1-6\" href=\"#tarifs\">\n                        <span data-kid=\"1-2-1-2-1-6-1\">\n                            05\n                        </span>\n                        Plans & limites\n                    </a>\n                    <div class=\"mt-16 border-t border-[#E4E0D8] pt-4 text-[10px] leading-relaxed text-[#9B978F]\" data-kid=\"1-2-1-2-1-7\">\n                        Un dossier à jour pour chaque logement.\n                    </div>\n                </aside>\n                <div class=\"min-w-0\" data-kid=\"1-2-1-2-2\">\n                    <div class=\"mb-8 max-w-[650px]\" data-kid=\"1-2-1-2-2-1\">\n                        <p class=\"lk-kicker mb-5\" data-kid=\"1-2-1-2-2-1-1\">\n                            Tableau de bord · Cotonou · Septembre 2026\n                        </p>\n                        <h1 class=\"lk-hero-title lk-editorial m-0 max-w-[680px] text-[clamp(3rem,5.2vw,5.2rem)] leading-[.98] tracking-[-.045em] text-[#18181B]\" data-kid=\"1-2-1-2-2-1-2\">\n                            Chaque logement a son dossier.\n                            <br data-kid=\"1-2-1-2-2-1-2-1\"/>\n                            <em class=\"text-[#087F5B]\" data-kid=\"1-2-1-2-2-1-2-2\">\n                                Chaque paiement, sa preuve.\n                            </em>\n                        </h1>\n                        <p class=\"mt-7 max-w-[590px] text-[16px] leading-[1.65] text-[#64635F]\" data-kid=\"1-2-1-2-2-1-3\">\n                            Lokka réunit les baux, loyers, quittances, incidents et logements disponibles dans un tableau de bord pensé pour les bailleurs, les agences et la diaspora.\n                        </p>\n                    </div>\n                    <div class=\"lk-sheet relative max-w-[760px] p-5 sm:p-7\" data-kid=\"1-2-1-2-2-2\" id=\"hero-board\">\n                        <div class=\"flex flex-col gap-4 border-b border-[#E4E0D8] pb-5 sm:flex-row sm:items-start sm:justify-between\" data-kid=\"1-2-1-2-2-2-1\">\n                            <div data-kid=\"1-2-1-2-2-2-1-1\">\n                                <div class=\"lk-kicker mb-2\" data-kid=\"1-2-1-2-2-2-1-1-1\">\n                                    Dossier bien · LK-CO-0048\n                                </div>\n                                <h2 class=\"m-0 text-[20px] font-bold tracking-[-.025em] text-[#18181B]\" data-kid=\"1-2-1-2-2-2-1-1-2\" data-name=\"hero card title\">\n                                    Villa Les Cocotiers\n                                </h2>\n                                <p class=\"mt-1 text-[12px] text-[#64635F]\" data-kid=\"1-2-1-2-2-2-1-1-3\">\n                                    Haie Vive · Cotonou · 5 unités · Patrimoine Lokka\n                                </p>\n                            </div>\n                            <span class=\"lk-stamp\" data-kid=\"1-2-1-2-2-2-1-2\">\n                                <i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"1-2-1-2-2-2-1-2-1\">\n                                </i>\n                                Dossier à jour\n                            </span>\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-4 border-b border-[#F0EDE6] py-5 sm:grid-cols-4 sm:gap-6\" data-kid=\"1-2-1-2-2-2-2\">\n                            <div data-kid=\"1-2-1-2-2-2-2-1\">\n     