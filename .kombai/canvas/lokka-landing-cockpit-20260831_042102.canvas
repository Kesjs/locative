td>\n                                <td class=\"border-l border-[#E4E0D8] px-5 py-4 text-[#087F5B] sm:px-6\" data-kid=\"1-2-7-1-3-1-2-8-4\">\n                                    <i class=\"ti ti-check icon\" data-kid=\"1-2-7-1-3-1-2-8-4-1\" style=\"color:#087F5B;width:16px;height:16px\">\n                                    </i>\n                                </td>\n                            </tr>\n                            <tr class=\"border-t border-[#E4E0D8]\" data-kid=\"1-2-7-1-3-1-2-9\">\n                                <td class=\"px-5 py-4 text-[#18181B] sm:px-7\" data-kid=\"1-2-7-1-3-1-2-9-1\">\n                                    Reversements automatiques aux bailleurs\n                                </td>\n                                <td class=\"border-l border-[#E4E0D8] px-5 py-4 text-[#A1A1AA] sm:px-6\" data-kid=\"1-2-7-1-3-1-2-9-2\">\n                                    —\n                                </td>\n                                <td class=\"border-l border-[#E4E0D8] px-5 py-4 text-[#A1A1AA] sm:px-6\" data-kid=\"1-2-7-1-3-1-2-9-3\">\n                                    —\n                                </td>\n                                <td class=\"border-l border-[#E4E0D8] px-5 py-4 text-[#087F5B] sm:px-6\" data-kid=\"1-2-7-1-3-1-2-9-4\">\n                                    <i class=\"ti ti-check icon\" data-kid=\"1-2-7-1-3-1-2-9-4-1\" style=\"color:#087F5B;width:16px;height:16px\">\n                                    </i>\n                                </td>\n                            </tr>\n                            <tr class=\"bg-[#F4F2EC]\" data-kid=\"1-2-7-1-3-1-2-10\">\n                                <th class=\"px-5 py-3 text-[11px] font-semibold uppercase tracking-[0.13em] text-[#71717A] sm:px-7\" colspan=\"4\" data-kid=\"1-2-7-1-3-1-2-10-1\">\n                                    Publier & trouver des locataires\n                                </th>\n                            </tr>\n                            <tr class=\"border-t border-[#E4E0D8]\" data-kid=\"1-2-7-1-3-1-2-11\">\n                                <td class=\"px-5 py-4 text-[#18181B] sm:px-7\" data-kid=\"1-2-7-1-3-1-2-11-1\">\n                                    Marketplace Lokka (annonces)\n                                </td>\n                                <td class=\"border-l border-[#E4E0D8] px-5 py-4 text-[#A1A1AA] sm:px-6\" data-kid=\"1-2-7-1-3-1-2-11-2\">\n                                    —\n                                </td>\n                                <td class=\"border-l border-[#E4E0D8] px-5 py-4 text-[#087F5B] sm:px-6\" data-kid=\"1-2-7-1-3-1-2-11-3\">\n                                    <i class=\"ti ti-check icon\" data-kid=\"1-2-7-1-3-1-2-11-3-1\" style=\"color:#087F5B;width:16px;height:16px\">\n                                    </i>\n                                </td>\n                                <td class=\"border-l border-[#E4E0D8] px-5 py-4 text-[#087F5B] sm:px-6\" data-kid=\"1-2-7-1-3-1-2-11-4\">\n                                    <i class=\"ti ti-check icon\" data-kid=\"1-2-7-1-3-1-2-11-4-1\" style=\"color:#087F5B;width:16px;height:16px\">\n                                    </i>\n                                </td>\n                            </tr>\n                            <tr class=\"border-t border-[#E4E0D8]\" data-kid=\"1-2-7-1-3-1-2-12\">\n                                <td class=\"px-5 py-4 text-[#18181B] sm:px-7\" data-kid=\"1-2-7-1-3-1-2-12-1\">\n                                    Vitrine web (lien standard)\n                                </td>\n                                <td class=\"border-l border-[#E4E0D8] px-5 py-4 text-[#A1A1AA] sm:px-6\" data-kid=\"1-2-7-1-3-1-2-12-2\">\n                                    —\n                                </td>\n                                <td class=\"border-l border-[#E4E0D8] px-5 py-4 text-[#087F5B] sm:px-6\" data-kid=\"1-2-7-1-3-1-2-12-3\">\n                                    <i class=\"ti ti-check icon\" data-kid=\"1-2-7-1-3-1-2-12-3-1\" style=\"color:#087F5B;width:16px;height:16px\">\n                                    </i>\n                                </td>\n                                <td class=\"border-l border-[#E4E0D8] px-5 py-4 text-[#087F5B] sm:px-6\" data-kid=\"1-2-7-1-3-1-2-12-4\">\n                                    <i class=\"ti ti-check icon\" data-kid=\"1-2-7-1-3-1-2-12-4-1\" style=\"color:#087F5B;width:16px;height:16px\">\n                                    </i>\n                                </td>\n                            </tr>\n                            <tr class=\"border-t border-[#E4E0D8]\" data-kid=\"1-2-7-1-3-1-2-13\">\n                                <td class=\"px-5 py-4 text-[#18181B] sm:px-7\" data-kid=\"1-2-7-1-3-1-2-13-1\">\n                                    Domaine personnalisé + thèmes\n                                </td>\n                                <td class=\"border-l border-[#E4E0D8] px-5 py-4 text-[#A1A1AA] sm:px-6\" data-kid=\"1-2-7-1-3-1-2-13-2\">\n                                    —\n                                </td>\n                                <td class=\"border-l border-[#E4E0D8] px-5 py-4 text-[#A1A1AA] sm:px-6\" data-kid=\"1-2-7-1-3-1-2-13-3\">\n                                    —\n                                </td>\n                                <td class=\"border-l border-[#E4E0D8] px-5 py-4 text-[#087F5B] sm:px-6\" data-kid=\"1-2-7-1-3-1-2-13-4\">\n                                    <i class=\"ti ti-check icon\" data-kid=\"1-2-7-1-3-1-2-13-4-1\" style=\"color:#087F5B;width:16px;height:16px\">\n                                    </i>\n                                </td>\n                            </tr>\n                            <tr class=\"border-t border-[#E4E0D8]\" data-kid=\"1-2-7-1-3-1-2-14\">\n                                <td class=\"px-5 py-4 text-[#18181B] sm:px-7\" data-kid=\"1-2-7-1-3-1-2-14-1\">\n                                    SEO & Blog inclus\n                                </td>\n                                <td class=\"border-l border-[#E4E0D8] px-5 py-4 text-[#A1A1AA] sm:px-6\" data-kid=\"1-2-7-1-3-1-2-14-2\">\n                                    —\n                                </td>\n                                <td class=\"border-l border-[#E4E0D8] px-5 py-4 text-[#A1A1AA] sm:px-6\" data-kid=\"1-2-7-1-3-1-2-14-3\">\n                                    —\n                                </td>\n                                <td class=\"border-l border-[#E4E0D8] px-5 py-4 text-[#087F5B] sm:px-6\" data-kid=\"1-2-7-1-3-1-2-14-4\">\n                                    <i class=\"ti ti-check icon\" data-kid=\"1-2-7-1-3-1-2-14-4-1\" style=\"color:#087F5B;width:16px;height:16px\">\n                                    </i>\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n                <div class=\"reveal grid gap-4 border-b border-[#D1CBBF] py-5 text-[12px] text-[#52525B] sm:grid-cols-2\" data-kid=\"1-2-7-1-4\">\n                    <p data-kid=\"1-2-7-1-4-1\">\n                        <span class=\"font-semibold text-[#18181B]\" data-kid=\"1-2-7-1-4-1-1\">\n                            Bailleur Pro :\n                        </span>\n                        +5 biens pour 2 000 FCFA/mois (jusqu'à 35 biens max)\n                    </p>\n                    <p data-kid=\"1-2-7-1-4-2\">\n                        <span class=\"font-semibold text-[#18181B]\" data-kid=\"1-2-7-1-4-2-1\">\n                            Agence Pro :\n                        </span>\n                        pack +100 biens pour 5 000 FCFA/mois\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-b border-[#E4E0D8] bg-white py-20 sm:py-28\" data-kid=\"1-2-8\" id=\"questions\">\n            <div class=\"mx-auto max-w-[1000px] px-5 sm:px-8\" data-kid=\"1-2-8-1\">\n                <div class=\"reveal max-w-[620px]\" data-kid=\"1-2-8-1-1\">\n                    <p class=\"text-[11px] font-semibold uppercase tracking-[0.16em] text-[#71717A]\" data-kid=\"1-2-8-1-1-1\">\n                        Questions de gestion\n                    </p>\n                    <h2 class=\"mt-4 text-[clamp(2.1rem,4vw,3.6rem)] font-semibold leading-[0.98] tracking-[-0.06em] text-[#18181B]\" data-kid=\"1-2-8-1-1-2\">\n                        Les réponses avant\n                        <br data-kid=\"1-2-8-1-1-2-1\"/>\n                        <span class=\"serif-display font-normal italic text-[#52525B]\" data-kid=\"1-2-8-1-1-2-2\">\n                            le premier dossier.\n                        </span>\n                    </h2>\n                    <p class=\"mt-5 text-[14px] leading-relaxed text-[#52525B]\" data-kid=\"1-2-8-1-1-3\">\n                        Pas de promesse vague : voici ce que chaque formule et chaque parcours impliquent.\n                    </p>\n                </div>\n                <div class=\"reveal mt-12 border-y border-[#D1CBBF]\" data-kid=\"1-2-8-1-2\">\n                    <details class=\"border-b border-[#E4E0D8] py-5\" data-kid=\"1-2-8-1-2-1\" data-name=\"faq item 1\" open=\"\">\n                        <summary class=\"flex items-center justify-between gap-5 text-[14px] font-semibold text-[#18181B]\" data-kid=\"1-2-8-1-2-1-1\">\n                            <span data-kid=\"1-2-8-1-2-1-1-1\">\n                                Quelle est la différence entre Découverte, Bailleur Pro et Agence Pro ?\n                            </span>\n                            <i class=\"ti ti-plus icon\" data-kid=\"1-2-8-1-2-1-1-2\" style=\"color:#18181B;width:17px;height:17px\">\n                            </i>\n                        </summary>\n                        <p class=\"max-w-[820px] pt-4 text-[13px] leading-relaxed text-[#52525B]\" data-kid=\"1-2-8-1-2-1-2\">\n                            Découverte est gratuit à vie pour 1 bien avec une gestion basique et des quittances PDF manuelles. Bailleur Pro, à 5 000 FCFA/mois ou 4 000 FCFA/mois avec facturation annuelle, débloque le Mobile Money, le portail locataire et la Marketplace Lokka jusqu'à 15 biens. Agence Pro, à 25 000 FCFA/mois ou 20 000 FCFA/mois annuels, ajoute les mandats, les reversements, le domaine personnalisé et le SEO/blog pour 50 biens inclus.\n                        </p>\n                    </details>\n                    <details class=\"border-b border-[#E4E0D8] py-5\" data-kid=\"1-2-8-1-2-2\" data-name=\"faq item 2\">\n                        <summary class=\"flex items-center justify-between gap-5 text-[14px] font-semibold text-[#18181B]\" data-kid=\"1-2-8-1-2-2-1\">\n                            <span data-kid=\"1-2-8-1-2-2-1-1\">\n                                Que se passe-t-il si je dépasse le plafond de biens ?\n                            </span>\n                            <i class=\"ti ti-plus icon\" data-kid=\"1-2-8-1-2-2-1-2\" style=\"color:#18181B;width:17px;height:17px\">\n                            </i>\n                        </summary>\n                        <p class=\"max-w-[820px] pt-4 text-[13px] leading-relaxed text-[#52525B]\" data-kid=\"1-2-8-1-2-2-2\">\n                            Vous pouvez ajouter +5 biens pour 2 000 FCFA/mois en Bailleur Pro, jusqu'à 35 biens maximum, ou un pack +100 biens pour 5 000 FCFA/mois en Agence Pro. Au-delà, contactez l'équipe Lokka.\n                        </p>\n                    </details>\n                    <details class=\"border-b border-[#E4E0D8] py-5\" data-kid=\"1-2-8-1-2-3\" data-name=\"faq item 3\">\n                        <summary class=\"flex items-center justify-between gap-5 text-[14px] font-semibold text-[#18181B]\" data-kid=\"1-2-8-1-2-3-1\">\n                            <span data-kid=\"1-2-8-1-2-3-1-1\">\n                                Comment les locataires accèdent-ils à leurs quittances ?\n                            </span>\n                            <i class=\"ti ti-plus icon\" data-kid=\"1-2-8-1-2-3-1-2\" style=\"color:#18181B;width:17px;height:17px\">\n                            </i>\n                        </summary>\n                        <p class=\"max-w-[820px] pt-4 text-[13px] leading-relaxed text-[#52525B]\" data-kid=\"1-2-8-1-2-3-2\">\n                            Ils reçoivent un accès sécurisé par email ou téléphone avec un code OTP. Leur espace web contient l'historique des mois payés et les quittances PDF officielles avec QR Code.\n                        </p>\n                    </details>\n                    <details class=\"border-b border-[#E4E0D8] py-5\" data-kid=\"1-2-8-1-2-4\" data-name=\"faq item 4\">\n                        <summary class=\"flex items-center justify-between gap-5 text-[14px] font-semibold text-[#18181B]\" data-kid=\"1-2-8-1-2-4-1\">\n                            <span data-kid=\"1-2-8-1-2-4-1-1\">\n                                Comment fonctionne l'encaissement MTN MoMo et Moov Money ?\n                            </span>\n                            <i class=\"ti ti-plus icon\" data-kid=\"1-2-8-1-2-4-1-2\" style=\"color:#18181B;width:17px;height:17px\">\n                            </i>\n                        </summary>\n                        <p class=\"max-w-[820px] pt-4 text-[13px] leading-relaxed text-[#52525B]\" data-kid=\"1-2-8-1-2-4-2\">\n                            Dès que la transaction est confirmée, le tableau de bord s'actualise et la quittance est générée automatiquement. Le locataire peut ensuite la retrouver depuis son portail.\n                        </p>\n                    </details>\n                    <details class=\"border-b border-[#E4E0D8] py-5\" data-kid=\"1-2-8-1-2-5\" data-name=\"faq item 5\">\n                        <summary class=\"flex items-center justify-between gap-5 text-[14px] font-semibold text-[#18181B]\" data-kid=\"1-2-8-1-2-5-1\">\n                            <span data-kid=\"1-2-8-1-2-5-1-1\">\n                                Comment Lokka applique-t-il la Loi n° 2022-30 ?\n                            </span>\n                            <i class=\"ti ti-plus icon\" data-kid=\"1-2-8-1-2-5-1-2\" style=\"color:#18181B;width:17px;height:17px\">\n                            </i>\n                        </summary>\n                        <p class=\"max-w-[820px] pt-4 text-[13px] leading-relaxed text-[#52525B]\" data-kid=\"1-2-8-1-2-5-2\">\n                            Le plafond de caution est limité à 3 mois de loyer, les quittances comportent les mentions légales obligatoires et la commission de gestion agence est plafonnée à 10% selon le périmètre présenté.\n                        </p>\n                    </details>\n                    <details class=\"border-b border-[#E4E0D8] py-5\" data-kid=\"1-2-8-1-2-6\" data-name=\"faq item 6\">\n                        <summary class=\"flex items-center justify-between gap-5 text-[14px] font-semibold text-[#18181B]\" data-kid=\"1-2-8-1-2-6-1\">\n                            <span data-kid=\"1-2-8-1-2-6-1-1\">\n                                La vitrine publique fonctionne-t-elle pour la diaspora ?\n                            </span>\n                            <i class=\"ti ti-plus icon\" data-kid=\"1-2-8-1-2-6-1-2\" style=\"color:#18181B;width:17px;height:17px\">\n                            </i>\n                        </summary>\n                        <p class=\"max-w-[820px] pt-4 text-[13px] leading-relaxed text-[#52525B]\" data-kid=\"1-2-8-1-2-6-2\">\n                            Oui. Les biens vacants peuvent être publiés sur une adresse comme agence-littoral.lokka.bj, avec loyers, photos disponibles, demande de visite et contact WhatsApp.\n                        </p>\n                    </details>\n                    <details class=\"py-5\" data-kid=\"1-2-8-1-2-7\" data-name=\"faq item 7\">\n                        <summary class=\"flex items-center justify-between gap-5 text-[14px] font-semibold text-[#18181B]\" data-kid=\"1-2-8-1-2-7-1\">\n                            <span data-kid=\"1-2-8-1-2-7-1-1\">\n                                Puis-je changer de formule ou annuler à tout moment ?\n                            </span>\n                            <i class=\"ti ti-plus icon\" data-kid=\"1-2-8-1-2-7-1-2\" style=\"color:#18181B;width:17px;height:17px\">\n                            </i>\n                        </summary>\n                        <p class=\"max-w-[820px] pt-4 text-[13px] leading-relaxed text-[#52525B]\" data-kid=\"1-2-8-1-2-7-2\">\n                            Oui, les forfaits mensuels sont sans engagement. Vous pouvez changer de plan ou annuler depuis vos paramètres sans frais de résiliation.\n                        </p>\n                    </details>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[#18181B] py-20 text-white sm:py-28\" data-kid=\"1-2-9\" id=\"signup-final\">\n            <div class=\"mx-auto grid max-w-[1240px] gap-12 px-5 sm:px-8 lg:grid-cols-[1fr_0.8fr] lg:items-end lg:gap-24 lg:px-10\" data-kid=\"1-2-9-1\">\n                <div class=\"reveal\" data-kid=\"1-2-9-1-1\">\n                    <p class=\"text-[11px] font-semibold uppercase tracking-[0.16em] text-white/55\" data-kid=\"1-2-9-1-1-1\">\n                        Premier dossier, première vue claire\n                    </p>\n                    <h2 class=\"mt-5 max-w-[720px] text-[clamp(2.45rem,5.4vw,5.2rem)] font-semibold leading-[0.94] tracking-[-0.07em] text-white\" data-kid=\"1-2-9-1-1-2\">\n                        Créez votre espace.\n                        <br data-kid=\"1-2-9-1-1-2-1\"/>\n                        <span class=\"serif-display font-normal italic text-white/70\" data-kid=\"1-2-9-1-1-2-2\">\n                            Commencez par un bien.\n                        </span>\n                    </h2>\n                    <p class=\"mt-6 max-w-[540px] text-[15px] leading-relaxed text-white/70\" data-kid=\"1-2-9-1-1-3\">\n                        Un code de connexion vous sera envoyé. Vous pourrez ensuite ajouter votre premier logement, inviter un locataire et suivre votre premier règlement.\n                    </p>\n                </div>\n                <div class=\"reveal border-t border-white/25 pt-5\" data-kid=\"1-2-9-1-2\">\n                    <form data-kid=\"1-2-9-1-2-1\" data-signup-form=\"\">\n                        <label class=\"mb-2 block text-[12px] font-semibold text-white\" data-kid=\"1-2-9-1-2-1-1\" for=\"final-email\">\n                            Adresse email\n                        </label>\n                        <div class=\"flex flex-col gap-2\" data-kid=\"1-2-9-1-2-1-2\">\n                            <input class=\"min-h-[48px] rounded-[6px] border border-white/25 bg-white px-3.5 text-[14px] text-[#18181B] outline-none placeholder:text-[#A1A1AA] focus:border-white focus:ring-2 focus:ring-white/20\" data-email=\"\" data-kid=\"1-2-9-1-2-1-2-1\" id=\"final-email\" placeholder=\"vous@exemple.com\" required=\"\" type=\"email\"/>\n                            <button class=\"inline-flex min-h-[48px] items-center justify-center gap-2 rounded-[6px] bg-white px-5 text-[13px] font-semibold text-[#18181B] hover:bg-[#E6F5EF] hover:text-[#087F5B]\" data-dynamic=\"true\" data-kid=\"1-2-9-1-2-1-2-2\" data-name=\"final signup button\" data-reason=\"text updated by script during form submission\" data-submit-button=\"\" type=\"submit\">\n                                Créer mon espace\n                                <i class=\"ti ti-arrow-right icon\" data-kid=\"1-2-9-1-2-1-2-2-1\" style=\"color:currentColor;width:16px;height:16px\">\n                                </i>\n                            </button>\n                        </div>\n                        <p aria-live=\"polite\" class=\"mt-3 text-[12px] leading-relaxed text-white/55\" data-kid=\"1-2-9-1-2-1-3\" data-signup-feedback=\"\">\n                            Essai gratuit 14 jours · Sans carte bancaire.\n                        </p>\n                    </form>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[#18181B] text-white\" data-kid=\"1-3\">\n        <div class=\"mx-auto flex max-w-[1240px] flex-col gap-5 border-t border-white/15 px-5 py-7 text-[12px] text-white/55 sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-10\" data-kid=\"1-3-1\" data-name=\"footer container\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-3-1-1\" data-name=\"footer logo container\">\n                <div class=\"flex h-7 w-7 items-center justify-center rounded-[6px] bg-white\" data-kid=\"1-3-1-1-1\" data-name=\"footer logo icon container\">\n                    <svg data-kid=\"1-3-1-1-1-1\" data-name=\"footer logo icon\" fill=\"none\" height=\"16\" viewbox=\"0 0 500 500\" width=\"16\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M195 87.5 L277 87.5 L231 237.5 L369 237.5 L323 372.5 L141.5 372.5 L180 252.5 L276.5 252.5 L230.5 317.5 L197.5 317.5 L217 252.5 M195 87.5\" fill=\"none\" stroke=\"#18181B\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"16\">\n                        </path>\n                    </svg>\n                </div>\n                <span class=\"serif-display text-[20px] text-white\" data-kid=\"1-3-1-1-2\" data-name=\"footer brand text\">\n                    Lokka.\n                </span>\n            </div>\n            <span data-kid=\"1-3-1-2\" data-name=\"footer copyright text\">\n                Gestion locative pour le Bénin et la diaspora · © 2026 Lokka\n            </span>\n            <span data-kid=\"1-3-1-3\" data-name=\"footer utility links\">\n                FCFA · MTN MoMo · Moov Money · Loi 2022-30\n            </span>\n        </div>\n    </footer>\n</div>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n  document.querySelectorAll('[data-scroll-target]').forEach((button) => {\n    button.addEventListener('click', () => {\n      const target = document.querySelector(button.getAttribute('data-scroll-target'));\n      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });\n    });\n  });\n\n  document.querySelectorAll('[data-receipt-toggle]').forEach((button) => {\n    button.addEventListener('click', () => {\n      const drawer = document.querySelector('#receipt-drawer');\n      const isOpen = drawer.classList.toggle('is-open');\n      button.setAttribute('aria-expanded', String(isOpen));\n      const icon = button.querySelector('i');\n      if (icon) icon.className = isOpen ? 'ti ti-arrow-up icon' : 'ti ti-arrow-down icon';\n    });\n  });\n\n  document.querySelectorAll('[data-action-toggle], [data-action-toggle-2]').forEach((button) => {\n    button.addEventListener('click', () => {\n      const detail = button.hasAttribute('data-action-toggle-2') ? button.parentElement.querySelector('[data-action-detail-2]') : button.parentElement.querySelector('.action-detail');\n      const isOpen = detail.classList.toggle('is-open');\n      button.setAttribute('aria-expanded', String(isOpen));\n      const label = button.querySelector('span');\n      if (label) label.textContent = isOpen ? 'Masquer le contexte' : (button.hasAttribute('data-action-toggle-2') ? 'Voir le contexte' : 'Envoyer une relance');\n    });\n  });\n\n  document.querySelectorAll('.role-tab').forEach((button) => {\n    button.addEventListener('click', () => {\n      const role = button.dataset.role;\n      document.querySelectorAll('.role-tab').forEach((tab) => tab.setAttribute('aria-selected', String(tab === button)));\n      document.querySelectorAll('[data-role-panel]').forEach((panel) => panel.classList.toggle('is-active', panel.dataset.rolePanel === role));\n    });\n  });\n\n  document.querySelector('[data-publish-button]')?.addEventListener('click', (event) => {\n    const button = event.currentTarget;\n    button.innerHTML = 'Annonce publiée <i class=\"ti ti-check icon\" style=\"color:#FFFFFF;width:15px;height:15px\"></i>';\n    document.querySelector('.publish-confirmation')?.classList.add('is-open');\n  });\n\n  document.querySelector('[data-request-button]')?.addEventListener('click', (event) => {\n    event.currentTarget.textContent = 'Visite demandée';\n    document.querySelector('[data-request-confirmation]')?.classList.add('is-open');\n  });\n\n  document.querySelector('[data-pricing-toggle]')?.addEventListener('click', (event) => {\n    const toggle = event.currentTarget;\n    const annual = toggle.getAttribute('aria-pressed') === 'true';\n    const nextAnnual = !annual;\n    toggle.setAttribute('aria-pressed', String(nextAnnual));\n    toggle.classList.toggle('bg-[#18181B]', nextAnnual);\n    toggle.classList.toggle('bg-[#D1CBBF]', !nextAnnual);\n    document.querySelectorAll('[data-plan-price]').forEach((price) => { price.textContent = nextAnnual ? price.dataset.annual : price.dataset.monthly; });\n    document.querySelectorAll('[data-plan-billing]').forEach((label) => { label.textContent = nextAnnual ? 'par mois facturé annuellement' : 'par mois sans engagement'; });\n    document.querySelector('[data-billing-label-annual]')?.classList.toggle('text-[#18181B]', nextAnnual);\n    document.querySelector('[data-billing-label-annual]')?.classList.toggle('text-[#71717A]', !nextAnnual);\n    document.querySelector('[data-billing-label-monthly]')?.classList.toggle('text-[#18181B]', !nextAnnual);\n    document.querySelector('[data-billing-label-monthly]')?.classList.toggle('text-[#71717A]', nextAnnual);\n  });\n\n  document.querySelectorAll('[data-signup-form]').forEach((form) => {\n    form.addEventListener('submit', (event) => {\n      event.preventDefault();\n      const email = form.querySelector('[data-email]').value.trim();\n      const button = form.querySelector('[data-submit-button]');\n      const feedback = form.querySelector('[data-signup-feedback]');\n      if (!email) return;\n      button.disabled = true;\n      button.textContent = 'Envoi du code…';\n      window.setTimeout(() => {\n        button.disabled = false;\n        button.textContent = 'Code envoyé';\n        feedback.textContent = 'Code envoyé à ' + email + '. Vérifiez votre boîte de réception.';\n        feedback.style.color = form.closest('#signup-final') ? 'rgba(255,255,255,0.9)' : '#087F5B';\n      }, 700);\n    });\n  });\n\n  const mm = gsap.matchMedia();\n  mm.add({ reduced: '(prefers-reduced-motion: reduce)' }, ({ conditions }) => {\n    if (conditions.reduced) {\n      gsap.set('.hero-copy, .hero-board, .hero-rail, .reveal, .chain-cell, .chain-line, .report-bar', { autoAlpha: 1, y: 0, x: 0, scaleX: 1, scaleY: 1 });\n      gsap.set('.event-pending', { autoAlpha: 0 });\n      gsap.set('.event-success, .receipt-reference', { autoAlpha: 1 });\n      return;\n    }\n\n    gsap.timeline({ defaults: { ease: 'power3.out' } })\n      .from('.hero-copy', { autoAlpha: 0, y: 24, duration: 0.7 })\n      .from('.hero-board', { autoAlpha: 0, x: 28, duration: 0.8 }, '-=0.42')\n      .from('.hero-rail', { autoAlpha: 0, x: 18, duration: 0.5 }, '-=0.42');\n\n    const resolveEvent = gsap.timeline({ paused: true, defaults: { ease: 'power2.out' } });\n    resolveEvent\n      .to('.event-pending', { autoAlpha: 0, duration: 0.18 })\n      .to('.event-success', { autoAlpha: 1, duration: 0.22 }, '<')\n      .fromTo('.receipt-reference', { autoAlpha: 0, x: -8 }, { autoAlpha: 1, x: 0, duration: 0.35 }, '+=0.05');\n    ScrollTrigger.create({ trigger: '#hero-board', start: 'top 78%', once: true, onEnter: () => resolveEvent.play() });\n\n    gsap.utils.toArray('.reveal').forEach((element) => {\n      gsap.from(element, { autoAlpha: 0, y: 24, duration: 0.6, ease: 'power3.out', scrollTrigger: { trigger: element, start: 'top 84%', once: true } });\n    });\n\n    gsap.timeline({ scrollTrigger: { trigger: '#proof', start: 'top 72%', once: true } })\n      .from('.chain-line', { scaleX: 0, duration: 0.85, ease: 'power2.inOut' })\n      .from('.chain-cell', { autoAlpha: 0, y: 16, duration: 0.45, stagger: 0.12 }, '-=0.5');\n\n    gsap.from('.report-bar', { scaleY: 0, duration: 0.65, stagger: 0.08, ease: 'power2.out', scrollTrigger: { trigger: '#control-room', start: 'top 78%', once: true } });\n  });\n</script>\n",
      "comments": [],
      "created": "2026-08-31T05:03:26.234919+00:00",
      "modified": "2026-08-31T05:07:00.826040+00:00",
      "id": "var_ef44e0f3c471",
      "viewportScrollY": 0
    },
    "var_d16c8a594daf": {
      "type": "variant",
      "label": "Lokka cockpit — Relevé du matin",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n.briefing-page {\n  --ink: #18181B;\n  --ink-soft: #52525B;\n  --ink-muted: #71717A;\n  --paper: #FFFFFF;\n  --canvas: #FAF9F6;\n  --wash: #F4F2EC;\n  --line: #E4E0D8;\n  --line-soft: #F0EDE6;\n  --green: #087F5B;\n  --green-soft: #E6F5EF;\n  --success: #16A34A;\n  --success-soft: #DCFCE7;\n  --amber: #B45309;\n  --amber-soft: #FEF3C7;\n  --danger: #B91C1C;\n  --danger-soft: #FEE2E2;\n  font-family: 'Inter', system-ui, sans-serif;\n  color: var(--ink);\n  background: var(--canvas);\n}\n.briefing-page .briefing-serif { font-family: 'Instrument Serif', Georgia, serif; }\n.briefing-page .tabular { font-variant-numeric: tabular-nums lining-nums; }\n.briefing-page .js-intro-copy,\n.briefing-page .js-intro-board,\n.briefing-page .js-section-reveal,\n.briefing-page .js-receipt { opacity: 0; transform: translateY(24px); }\n.briefing-page .js-event-line { transform: scaleY(0); transform-origin: top center; }\n.briefing-page .js-transfer-line { transform: scaleX(0); transform-origin: left center; }\n.briefing-page .js-bar { transform: scaleY(0); transform-origin: bottom center; }\n.briefing-page [data-mode].is-active,\n.briefing-page [data-vitrine].is-active {\n  background: var(--ink);\n  color: #FFFFFF;\n  border-color: var(--ink);\n}\n.briefing-page [data-mode]:not(.is-active),\n.briefing-page [data-vitrine]:not(.is-active) { color: var(--ink-soft); }\n.briefing-page details summary { list-style: none; cursor: pointer; }\n.briefing-page details summary::-webkit-details-marker { display: none; }\n.briefing-page details[open] summary .faq-chevron { transform: rotate(180deg); }\n.briefing-page .faq-chevron { transform: rotate(0deg); }\n.briefing-page .receipt-drawer[hidden],\n.briefing-page [hidden] { display: none; }\n.briefing-page input:focus-visible,\n.briefing-page button:focus-visible,\n.briefing-page a:focus-visible,\n.briefing-page summary:focus-visible { outline: 2px solid var(--green); outline-offset: 3px; }\n</style>\n<div class=\"briefing-page min-h-screen bg-[#FAF9F6]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-[#E4E0D8] bg-[#FAF9F6]\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto flex max-w-[1280px] items-center justify-between gap-6 px-6 py-4 lg:px-8\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <a aria-label=\"Lokka, retour en haut\" class=\"inline-flex items-center gap-3 no-underline\" data-kid=\"1-1-1-1\" data-name=\"logo and brand name link\" href=\"#top\">\n                <span aria-hidden=\"true\" class=\"flex h-9 w-9 items-center justify-center rounded-[8px] bg-[#18181B]\" data-kid=\"1-1-1-1-1\" data-name=\"logo icon container\">\n                    <svg data-kid=\"1-1-1-1-1-1\" data-name=\"brand logo icon\" fill=\"none\" height=\"21\" viewbox=\"0 0 500 500\" width=\"21\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M195 87.5 L277 87.5 L231 237.5 L369 237.5 L323 372.5 L141.5 372.5 L180 252.5 L276.5 252.5 L230.5 317.5 L197.5 317.5 L217 252.5 M195 87.5\" fill=\"none\" stroke=\"#FFFFFF\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"18\">\n                        </path>\n                    </svg>\n                </span>\n                <span class=\"briefing-serif text-[25px] leading-none tracking-[-0.03em] text-[#18181B]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    Lokka.\n                </span>\n            </a>\n            <nav aria-label=\"Navigation principale\" class=\"hidden items-center gap-7 text-[13px] font-medium text-[#52525B] lg:flex\" data-kid=\"1-1-1-2\" data-name=\"navigation menu\">\n                <a class=\"hover:text-[#18181B]\" data-kid=\"1-1-1-2-1\" data-name=\"navigation link fonctionnement\" href=\"#workflow\">\n                    Fonctionnement\n                </a>\n                <a class=\"hover:text-[#18181B]\" data-kid=\"1-1-1-2-2\" data-name=\"navigation link pour les agences\" href=\"#views\">\n                    Pour les agences\n                </a>\n                <a class=\"hover:text-[#18181B]\" data-kid=\"1-1-1-2-3\" data-name=\"navigation link tarifs\" href=\"#pricing\">\n                    Tarifs\n                </a>\n                <a class=\"hover:text-[#18181B]\" data-kid=\"1-1-1-2-4\" data-name=\"navigation link questions\" href=\"#faq\">\n                    Questions\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-3\" data-name=\"auth action container\">\n                <a class=\"hidden text-[13px] font-semibold text-[#18181B] hover:underline sm:inline\" data-kid=\"1-1-1-3-1\" data-name=\"login link\" href=\"#signup\">\n                    Connexion\n                </a>\n                <a class=\"inline-flex min-h-[42px] items-center gap-2 rounded-[6px] bg-[#18181B] px-4 text-[13px] font-semibold text-white hover:bg-[#27272A]\" data-kid=\"1-1-1-3-2\" data-name=\"primary sign up button\" href=\"#signup\">\n                    Créer mon espace\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-[16px]\" data-kid=\"1-1-1-3-2-1\" data-name=\"arrow-up-right icon\" style=\"width:16px;height:16px;color:#FFFFFF;\">\n                    </i>\n                </a>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content container\">\n        <section class=\"border-b border-[#E4E0D8] bg-[#FAF9F6] py-12 sm:py-16 lg:py-20\" data-kid=\"1-2-1\" data-name=\"hero section\" id=\"top\">\n            <div class=\"mx-auto max-w-[1280px] px-6 lg:px-8\" data-kid=\"1-2-1-1\" data-name=\"hero section container\">\n                <div class=\"mb-10 flex flex-wrap items-center justify-between gap-3 text-[11px] font-semibold uppercase tracking-[0.16em] text-[#71717A]\" data-kid=\"1-2-1-1-1\" data-name=\"hero status badge container\">\n                    <span data-kid=\"1-2-1-1-1-1\" data-name=\"hero status text\">\n                        Votre patrimoine aujourd'hui\n                    </span>\n                    <span class=\"inline-flex items-center gap-2 normal-case tracking-normal text-[#52525B]\" data-kid=\"1-2-1-1-1-2\" data-name=\"demo site indicator\">\n                        <span class=\"h-2 w-2 rounded-full bg-[#16A34A]\" data-kid=\"1-2-1-1-1-2-1\" data-name=\"demo active indicator dot\">\n                        </span>\n                        Données de démonstration · Cotonou\n                    </span>\n                </div>\n                <div class=\"grid items-start gap-12 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-16\" data-kid=\"1-2-1-1-2\" data-name=\"hero grid layout container\">\n                    <div class=\"min-w-0\" data-kid=\"1-2-1-1-2-1\" data-name=\"hero primary content block\">\n                        <div class=\"js-intro-copy max-w-[760px]\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"hero copy block\">\n                            <p class=\"mb-5 text-[12px] font-semibold uppercase tracking-[0.18em] text-[#087F5B]\" data-kid=\"1-2-1-1-2-1-1-1\" data-name=\"hero sub-headline\">\n                                Le cockpit locatif du quotidien\n                            </p>\n                            <h1 class=\"max-w-[780px] text-[clamp(2.7rem,5.4vw,5.25rem)] font-semibold leading-[0.98] tracking-[-0.065em] text-[#18181B]\" data-kid=\"1-2-1-1-2-1-1-2\" data-name=\"hero main headline\">\n                                Vos loyers,\n                                <br data-kid=\"1-2-1-1-2-1-1-2-1\" data-name=\"line break\"/>\n                                <span class=\"briefing-serif font-normal tracking-[-0.04em] text-[#52525B]\" data-kid=\"1-2-1-1-2-1-1-2-2\" data-name=\"hero main headline highlighted text\">\n                                    les documents\n                                </span>\n                                et\n                                <br data-kid=\"1-2-1-1-2-1-1-2-3\" data-name=\"line break\"/>\n                                ce qui demande votre attention.\n                            </h1>\n                            <p class=\"mt-7 max-w-[610px] text-[16px] leading-[1.7] text-[#52525B] sm:text-[18px]\" data-kid=\"1-2-1-1-2-1-1-3\" data-name=\"hero description text\">\n                                Encaissements Mobile Money, quittances officielles, baux et logements disponibles réunis dans un même tableau de bord — pour savoir quoi faire, sans chercher.\n                            </p>\n                            <div class=\"mt-8 flex flex-wrap items-center gap-4 text-[13px] font-semibold\" data-kid=\"1-2-1-1-2-1-1-4\" data-name=\"hero call to action button group\">\n                                <a class=\"inline-flex min-h-[44px] items-center gap-2 rounded-[6px] bg-[#18181B] px-5 text-white hover:bg-[#27272A]\" data-kid=\"1-2-1-1-2-1-1-4-1\" data-name=\"primary workflow button\" href=\"#workflow\">\n                                    Voir le parcours d'un loyer\n                                    <i aria-hidden=\"true\" class=\"ti ti-arrow-down-right text-[17px]\" data-kid=\"1-2-1-1-2-1-1-4-1-1\" data-name=\"arrow-down-right icon\" style=\"width:17px;height:17px;color:#FFFFFF;\">\n                                    </i>\n                                </a>\n                                <a class=\"inline-flex min-h-[44px] items-center gap-2 text-[#18181B] underline decoration-[#B9B4AA] underline-offset-4 hover:decoration-[#18181B]\" data-kid=\"1-2-1-1-2-1-1-4-2\" data-name=\"secondary pricing link\" href=\"#pricing\">\n                                    Consulter les tarifs\n                                    <i aria-hidden=\"true\" class=\"ti ti-arrow-right text-[16px]\" data-kid=\"1-2-1-1-2-1-1-4