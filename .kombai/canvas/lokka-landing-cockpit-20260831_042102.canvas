            <div class=\"lk-kicker mb-2\" data-kid=\"1-2-1-2-2-2-2-4-1\">\n                                    Accès\n                                </div>\n                                <div class=\"lk-record-title\" data-kid=\"1-2-1-2-2-2-2-4-2\">\n                                    OTP actif\n                                </div>\n                                <div class=\"lk-record-meta mt-1\" data-kid=\"1-2-1-2-2-2-2-4-3\">\n                                    Portail locataire\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"lk-record-row\" data-kid=\"1-2-1-2-2-2-3\">\n                            <div class=\"flex min-w-0 items-start gap-3\" data-kid=\"1-2-1-2-2-2-3-1\">\n                                <span class=\"mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#E6F5EF] text-[#087F5B]\" data-kid=\"1-2-1-2-2-2-3-1-1\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"1-2-1-2-2-2-3-1-1-1\" style=\"width:16px;height:16px;font-size:16px;line-height:16px\">\n                                    </i>\n                                </span>\n                                <div class=\"min-w-0\" data-kid=\"1-2-1-2-2-2-3-1-2\">\n                                    <div class=\"lk-status text-[#087F5B]\" data-kid=\"1-2-1-2-2-2-3-1-2-1\">\n                                        <span class=\"lk-status-dot lk-status-dot-green\" data-kid=\"1-2-1-2-2-2-3-1-2-1-1\">\n                                        </span>\n                                        Paiement confirmé\n                                    </div>\n                                    <div class=\"lk-record-title mt-1\" data-kid=\"1-2-1-2-2-2-3-1-2-2\">\n                                        Koudjo Dossou a réglé 350 000 FCFA par MTN MoMo.\n                                    </div>\n                                    <div class=\