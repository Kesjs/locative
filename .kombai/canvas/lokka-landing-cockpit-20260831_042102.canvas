    },
    "var_ef44e0f3c471": {
      "type": "variant",
      "label": "Lokka cockpit — Grand livre vivant",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n.lokka-page {\n  font-family: 'Inter', sans-serif;\n  color: #18181B;\n  background: #FAF9F6;\n  letter-spacing: -0.01em;\n}\n.lokka-page .serif-display {\n  font-family: 'Instrument Serif', Georgia, serif;\n}\n.lokka-page .tabular {\n  font-variant-numeric: tabular-nums;\n  letter-spacing: -0.035em;\n}\n.lokka-page .icon {\n  display: inline-block;\n  width: 16px;\n  height: 16px;\n  line-height: 16px;\n  flex: 0 0 16px;\n}\n.lokka-page .receipt-drawer {\n  display: grid;\n  grid-template-rows: 0fr;\n  overflow: hidden;\n  transition: grid-template-rows 220ms ease-out;\n}\n.lokka-page .receipt-drawer > div {\n  min-height: 0;\n  overflow: hidden;\n}\n.lokka-page .receipt-drawer.is-open {\n  grid-template-rows: 1fr;\n}\n.lokka-page .event-success,\n.lokka-page .receipt-reference {\n  opacity: 0;\n}\n.lokka-page .role-panel {\n  display: none;\n}\n.lokka-page .role-panel.is-active {\n  display: block;\n}\n.lokka-page .role-tab[aria-selected=\"true\"] {\n  background: #18181B;\n  color: #FFFFFF;\n}\n.lokka-page .role-tab[aria-selected=\"false\"] {\n  color: #71717A;\n}\n.lokka-page .pricing-toggle-thumb {\n  transform: translateX(0);\n}\n.lokka-page .pricing-toggle[aria-pressed=\"true\"] .pricing-toggle-thumb {\n  transform: translateX(24px);\n}\n.lokka-page .report-bar {\n  transform-origin: center bottom;\n}\n.lokka-page .chain-line,\n.lokka-page .vacancy-line {\n  transform-origin: left center;\n}\n.lokka-page .action-detail,\n.lokka-page .request-confirmation,\n.lokka-page .publish-confirmation {\n  display: none;\n}\n.lokka-page .action-detail.is-open,\n.lokka-page .request-confirmation.is-open,\n.lokka-page .publish-confirmation.is-open {\n  display: block;\n}\n.lokka-page details summary {\n  list-style: none;\n  cursor: pointer;\n}\n.lokka-page details summary::-webkit-details-marker {\n  display: none;\n}\n.lokka-page .fine-rule {\n  background-image: linear-gradient(to right, #E4E0D8 1px, transparent 1px);\n  background-size: 24px 100%;\n}\n</style>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<div class=\"lokka-page min-h-screen overflow-hidden bg-[#FAF9F6]\" data-kid=\"1\">\n    <header class=\"border-b border-[#E4E0D8] bg-[#FAF9F6]\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex max-w-[1240px] items-center justify-between px-5 py-4 sm:px-8 lg:px-10\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\">\n                <div aria-hidden=\"true\" class=\"flex h-9 w-9 items-center justify-center rounded-[8px] bg-[#18181B]\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo icon container\">\n                    <svg data-kid=\"1-1-1-1-1-1\" data-name=\"brand logo icon\" fill=\"none\" height=\"21\" viewbox=\"0 0 500 500\" width=\"21\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M195 87.5 L277 87.5 L231 237.5 L369 237.5 L323 372.5 L141.5 372.5 L180 252.5 L276.5 252.5 L230.5 317.5 L197.5 317.5 L217 252.5 M195 87.5\" fill=\"none\" stroke=\"#FFFFFF\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"16\">\n                        </path>\n                    </svg>\n                </div>\n                <span class=\"serif-display text-[25px] leading-none tracking-tight\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    Lokka.\n                </span>\n            </div>\n            <div class=\"hidden items-center gap-7 text-[13px] font-medium text-[#52525B] lg:flex\" data-kid=\"1-1-1-2\" data-name=\"navigation menu\">\n                <button class=\"hover:text-[#18181B]\" data-kid=\"1-1-1-2-1\" data-name=\"functionality navigation button\" data-scroll-target=\"#proof\" type=\"button\">\n                    Fonctionnement\n                </button>\n                <button class=\"hover:text-[#18181B]\" data-kid=\"1-1-1-2-2\" data-name=\"agencies navigation button\" data-scroll-target=\"#roles\" type=\"button\">\n                    Pour les agences\n                </button>\n                <button class=\"hover:text-[#18181B]\" data-kid=\"1-1-1-2-3\" data-name=\"pricing navigation button\" data-scroll-target=\"#pricing\" type=\"button\">\n                    Tarifs\n                </button>\n                <button class=\"hover:text-[#18181B]\" data-kid=\"1-1-1-2-4\" data-name=\"faq navigation button\" data-scroll-target=\"#questions\" type=\"button\">\n                    Questions\n                </button>\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-3\">\n                <span class=\"hidden text-[12px] font-medium text-[#71717A] sm:inline\" data-kid=\"1-1-1-3-1\" data-name=\"location indicator text\">\n                    Bénin · Diaspora\n                </span>\n                <button class=\"inline-flex min-h-[40px] items-center gap-2 rounded-[6px] bg-[#18181B] px-4 text-[13px] font-semibold text-white hover:bg-[#27272A]\" data-kid=\"1-1-1-3-2\" data-name=\"create space button\" data-scroll-target=\"#signup-final\" type=\"button\">\n                    Créer mon espace\n                    <i class=\"ti ti-arrow-up-right icon\" data-kid=\"1-1-1-3-2-1\" data-name=\"button arrow-up-right icon\" style=\"color:#FFFFFF;width:16px;height:16px\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\">\n        <section class=\"relative border-b border-[#E4E0D8] py-16 sm:py-24 lg:py-28\" data-kid=\"1-2-1\" id=\"hero\">\n            <div class=\"pointer-events-none absolute right-0 top-0 hidden h-full w-[42%] opacity-35 lg:block\" data-kid=\"1-2-1-1\" data-name=\"hero background decorative pattern\" style=\"background-image:linear-gradient(to right, transparent, rgba(228,224,216,0.35)), linear-gradient(#E4E0D8 1px, transparent 1px), linear-gradient(90deg, #E4E0D8 1px, transparent 1px);background-size:auto,32px 32px,32px 32px;mask-image:linear-gradient(to bottom,black,transparent 82%);\">\n            </div>\n            <div class=\"relative mx-auto max-w-[1240px] px-5 sm:px-8 lg:px-10\" data-kid=\"1-2-1-2\">\n                <div class=\"grid items-start gap-12 lg:grid-cols-12 lg:gap-10\" data-kid=\"1-2-1-2-1\">\n                    <div class=\"hero-copy lg:col-span-4 lg:pt-9\" data-kid=\"1-2-1-2-1-1\">\n                        <div class=\"mb-6 flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-[#71717A]\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"hero section subheader container\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#087F5B]\" data-kid=\"1-2-1-2-1-1-1-1\" data-name=\"status dot indicator\">\n                            </span>\n                            Votre patrimoine aujourd'hui\n                        </div>\n                        <h1 class=\"max-w-[470px] text-[clamp(2.7rem,5.3vw,5rem)] font-semibold leading-[0.98] tracking-[-0.065em] text-[#18181B]\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"hero main headline text\">\n                            Le point sur vos loyers,\n                            <span class=\"serif-display mt-2 block font-normal italic tracking-[-0.045em] text-[#52525B]\" data-kid=\"1-2-1-2-1-1-2-1\" data-name=\"hero subheadline text\">\n                                avant même votre café.\n                            </span>\n                        </h1>\n                        <p class=\"mt-7 max-w-[420px] text-[15px] leading-[1.75] text-[#52525B] sm:text-[16px]\" data-kid=\"1-2-1-2-1-1-3\" data-name=\"hero description text\">\n                            Encaissements Mobile Money, quittances officielles, baux et logements disponibles réunis dans un même tableau de bord.\n                        </p>\n                        <form class=\"mt-9 max-w-[430px] border-t border-[#18181B] pt-4\" data-kid=\"1-2-1-2-1-1-4\" data-name=\"signup form\" data-signup-form=\"\">\n                            <label class=\"mb-2 block text-[12px] font-semibold text-[#18181B]\" data-kid=\"1-2-1-2-1-1-4-1\" data-name=\"email label\" for=\"hero-email\">\n                                Adresse email\n                            </label>\n                            <div class=\"flex flex-col gap-2 sm:flex-row\" data-kid=\"1-2-1-2-1-1-4-2\">\n                                <input class=\"min-h-[46px] min-w-0 flex-1 rounded-[6px] border border-[#D1CBBF] bg-white px-3.5 text-[14px] text-[#18181B] outline-none placeholder:text-[#A1A1AA] focus:border-[#18181B] focus:ring-2 focus:ring-[#18181B]/10\" data-email=\"\" data-kid=\"1-2-1-2-1-1-4-2-1\" data-name=\"email input field\" id=\"hero-email\" placeholder=\"vous@exemple.com\" required=\"\" type=\"email\"/>\n                                <button class=\"inline-flex min-h-[46px] items-center justify-center gap-2 rounded-[6px] bg-[#18181B] px-5 text-[13px] font-semibold text-white hover:bg-[#27272A]\" data-kid=\"1-2-1-2-1-1-4-2-2\" data-name=\"submit signup button\" data-submit-button=\"\" type=\"submit\">\n                                    Créer mon espace\n                                    <i class=\"ti ti-arrow-right icon\" data-kid=\"1-2-1-2-1-1-4-2-2-1\" data-name=\"button arrow-right icon\" style=\"color:#FFFFFF;width:16px;height:16px\">\n                                    </i>\n                                </button>\n                            </div>\n                            <p aria-live=\"polite\" class=\"mt-3 text-[12px] leading-relaxed text-[#71717A]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-1-4-3\" data-name=\"signup feedback message\" data-reason=\"feedback text updated by script after form submission\" data-signup-feedback=\"\">\n                                Essai gratuit 14 jours · Sans carte bancaire · Un code de connexion sera envoyé.\n                            </p>\n                        </form>\n                    </div>\n                    <div class=\"hero-board lg:col-span-8\" data-kid=\"1-2-1-2-1-2\" data-name=\"hero dashboard preview\" id=\"hero-board\">\n                        <div class=\"grid overflow-hidden border border-[#D1CBBF] bg-white lg:grid-cols-[minmax(0,1fr)_250px]\" data-kid=\"1-2-1-2-1-2-1\">\n                            <div class=\"min-w-0\" data-kid=\"1-2-1-2-1-2-1-1\">\n                                <div class=\"flex flex-col justify-between gap-3 border-b border-[#E4E0D8] px-5 py-4 sm:flex-row sm:items-center sm:px-7\" data-kid=\"1-2-1-2-1-2-1-1-1\">\n                                    <div data-kid=\"1-2-1-2-1-2-1-1-1-1\">\n                                        <div class=\"flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.13em] text-[#71717A]\" data-kid=\"1-2-1-2-1-2-1-1-1-1-1\">\n                                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#087F5B]\" data-kid=\"1-2-1-2-1-2-1-1-1-1-1-1\" data-name=\"dashboard status dot\">\n                                            </span>\n                                            Tableau de bord\n                                        </div>\n                                        <p class=\"mt-1 text-[18px] font-semibold tracking-[-0.035em] text-[#18181B]\" data-kid=\"1-2-1-2-1-2-1-1-1-1-2\" data-name=\"dashboard title text\">\n                                            Patrimoine Lokka\n                                            <span class=\"font-normal text-[#71717A]\" data-kid=\"1-2-1-2-1-2-1-1-1-1-2-1\" data-name=\"dashboard metadata text\">\n                                                · Bailleur · Cotonou\n                                            </span>\n                                        </p>\n                                    </div>\n                                    <div class=\"text-left text-[12px] text-[#71717A] sm:text-right\" data-kid=\"1-2-1-2-1-2-1-1-1-2\">\n                                        <p class=\"font-medium text-[#52525B]\" data-kid=\"1-2-1-2-1-2-1-1-1-2-1\" data-name=\"dashboard month title\">\n                                            Septembre 2026\n                                        </p>\n                                        <p data-kid=\"1-2-1-2-1-2-1-1-1-2-2\" data-name=\"dashboard update status text\">\n                                            Mis à jour aujourd'hui\n                                        </p>\n                                    </div>\n                                </div>\n                                <div class=\"grid grid-cols-1 border-b border-[#E4E0D8] sm:grid-cols-3\" data-kid=\"1-2-1-2-1-2-1-1-2\">\n                                    <div class=\"border-b border-[#E4E0D8] px-5 py-5 sm:border-b-0 sm:border-r sm:px-6\" data-kid=\"1-2-1-2-1-2-1-1-2-1\">\n                                        <p class=\"text-[11px] font-medium text-[#71717A]\" data-kid=\"1-2-1-2-1-2-1-1-2-1-1\">\n                                            Encaissé ce mois\n                                        </p>\n                                        <p class=\"tabular mt-2 text-[24px] font-semibold tracking-tight text-[#18181B]\" data-kid=\"1-2-1-2-1-2-1-1-2-1-2\">\n                                            1 450 000\n                                            <span class=\"font-sans text-[12px] font-medium tracking-normal text-[#71717A]\" data-kid=\"1-2-1-2-1-2-1-1-2-1-2-1\">\n                                                FCFA\n                                            </span>\n                                        </p>\n                                        <p class=\"mt-1 text-[11px] font-medium text-[#087F5B]\" data-kid=\"1-2-1-2-1-2-1-1-2-1-3\" data-name=\"dashboard performance status\">\n                                            Règlements rapprochés\n                                        </p>\n                                    </div>\n                                    <div class=\"border-b border-[#E4E0D8] px-5 py-5 sm:border-b-0 sm:border-r sm:px-6\" data-kid=\"1-2-1-2-1-2-1-1-2-2\">\n                                        <p class=\"text-[11px] font-medium text-[#71717A]\" data-kid=\"1-2-1-2-1-2-1-1-2-2-1\">\n                                            Reste à recouvrer\n                                        </p>\n                                        <p class=\"tabular mt-2 text-[24px] font-semibold tracking-tight text-[#18181B]\" data-kid=\"1-2-1-2-1-2-1-1-2-2-2\">\n                                            350 000\n                                            <span class=\"font-sans text-[12px] font-medium tracking-normal text-[#71717A]\" data-kid=\"1-2-1-2-1-2-1-1-2-2-2-1\">\n                                                FCFA\n                                            </span>\n                                        </p>\n                                        <p class=\"mt-1 text-[11px] font-medium text-[#B45309]\" data-kid=\"1-2-1-2-1-2-1-1-2-2-3\" data-name=\"dashboard action status\">\n                                            1 action à traiter\n                                        </p>\n                                    </div>\n                                    <div class=\"px-5 py-5 sm:px-6\" data-kid=\"1-2-1-2-1-2-1-1-2-3\">\n                                        <p class=\"text-[11px] font-medium text-[#71717A]\" data-kid=\"1-2-1-2-1-2-1-1-2-3-1\">\n                                            Occupation\n                                        </p>\n                                        <p class=\"tabular mt-2 text-[24px] font-semibold tracking-tight text-[#18181B]\" data-kid=\"1-2-1-2-1-2-1-1-2-3-2\">\n                                            4 / 5\n                                            <span class=\"font-sans text-[12px] font-medium tracking-normal text-[#71717A]\" data-kid=\"1-2-1-2-1-2-1-1-2-3-2-1\">\n                                                lots\n                                            </span>\n                                        </p>\n                                        <p class=\"mt-1 text-[11px] font-medium text-[#52525B]\" data-kid=\"1-2-1-2-1-2-1-1-2-3-3\">\n                                            1 logement disponible\n                                        </p>\n                                    </div>\n                                </div>\n                                <div class=\"px-5 py-5 sm:px-7 sm:py-7\" data-kid=\"1-2-1-2-1-2-1-1-3\">\n                                    <div class=\"mb-4 flex items-center justify-between gap-4\" data-kid=\"1-2-1-2-1-2-1-1-3-1\">\n                                        <div data-kid=\"1-2-1-2-1-2-1-1-3-1-1\">\n                                            <p class=\"text-[11px] font-semibold uppercase tracking-[0.13em] text-[#71717A]\" data-kid=\"1-2-1-2-1-2-1-1-3-1-1-1\">\n                                                Dernier règlement\n                                            </p>\n                                            <p class=\"mt-1 text-[14px] font-semibold text-[#18181B]\" data-kid=\"1-2-1-2-1-2-1-1-3-1-1-2\">\n                                                Le paiement devient un document.\n                                            </p>\n                                        </div>\n                                        <button aria-controls=\"receipt-drawer\" aria-expanded=\"false\" class=\"inline-flex min-h-[38px] items-center gap-2 border-b border-[#18181B] text-[12px] font-semibold text-[#18181B] hover:text-[#087F5B]\" data-kid=\"1-2-1-2-1-2-1-1-3-1-2\" data-name=\"view receipt toggle button\" data-receipt-toggle=\"\" type=\"button\">\n                                            Voir la quittance\n                                            <i class=\"ti ti-arrow-down icon\" data-kid=\"1-2-1-2-1-2-1-1-3-1-2-1\" style=\"color:#18181B;width:15px;height:15px\">\n                                            </i>\n                                        </button>\n                                    </div>\n                                    <div class=\"border-y border-[#E4E0D8]\" data-kid=\"1-2-1-2-1-2-1-1-3-2\">\n                                        <div class=\"grid gap-4 px-0 py-4 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-center sm:gap-6\" data-kid=\"1-2-1-2-1-2-1-1-3-2-1\">\n                                            <div class=\"min-w-0\" data-kid=\"1-2-1-2-1-2-1-1-3-2-1-1\">\n                                                <div class=\"flex items-center gap-2\" data-kid=\"1-2-1-2-1-2-1-1-3-2-1-1-1\" data-name=\"receipt pending status icon\">\n                                                    <span class=\"relative flex h-2 w-2 shrink-0\" data-kid=\"1-2-1-2-1-2-1-1-3-2-1-1-1-1\" data-name=\"receipt pulse animation ring\">\n                                                        <span class=\"absolute inline-flex h-full w-full rounded-full bg-[#F59E0B] opacity-60\" data-kid=\"1-2-1-2-1-2-1-1-3-2-1-1-1-1-1\">\n                                                        </span>\n                                                        <span class=\"relative inline-flex h-2 w-2 rounded-full bg-[#F59E0B]\" data-kid=\"1-2-1-2-1-2-1-1-3-2-1-1-1-1-2\">\n                                                        </span>\n                                                    </span>\n                                                    <span class=\"relative inline-flex min-h-[20px] items-center text-[12px] font-semibold\" data-kid=\"1-2-1-2-1-2-1-1-3-2-1-1-1-2\" data-name=\"receipt pulse dot\">\n                                                        <span class=\"event-pending absolute whitespace-nowrap text-[#B45309]\" data-kid=\"1-2-1-2-1-2-1-1-3-2-1-1-1-2-1\" data-name=\"receipt status pending text\">\n                                                            En attente de rapprochement\n                                                        </span>\n                                                        <span class=\"event-success whitespace-nowrap text-[#087F5B]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-2-1-1-3-2-1-1-1-2-2\" data-name=\"receipt status success text\" data-reason=\"opacity toggled by animation script\">\n                                                            Encaissé · confirmé\n                                                        </span>\n                                                    </span>\n                                                </div>\n                                                <p class=\"mt-2 truncate text-[14px] font-semibold text-[#18181B]\" data-kid=\"1-2-1-2-1-2-1-1-3-2-1-1-2\" data-name=\"receipt tenant name text\">\n                                                    Koudjo Dossou\n                                                    <span class=\"font-normal text-[#71717A]\" data-kid=\"1-2-1-2-1-2-1-1-3-2-1-1-2-1\">\n                                                        · Villa Fidjrossè Plage\n                                                    </span>\n                                                </p>\n                                                <p class=\"mt-1 text-[12px] text-[#71717A]\" data-kid=\"1-2-1-2-1-2-1-1-3-2-1-1-3\">\n                                                    MTN MoMo · 02 septembre 2026\n                                                </p>\n                                            </div>\n                                            <div class=\"text-left sm:text-right\" data-kid=\"1-2-1-2-1-2-1-1-3-2-1-2\">\n                                                <p class=\"tabular text-[17px] font-semibold text-[#18181B]\" data-kid=\"1-2-1-2-1-2-1-1-3-2-1-2-1\">\n                                                    350 000 FCFA\n                                                </p>\n                                                <p class=\"receipt-reference mt-1 text-[11px] font-medium text-[#087F5B]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-2-1-1-3-2-1-2-2\" data-name=\"receipt reference code text\" data-reason=\"opacity toggled by animation script\">\n                                                    LOK-2026-0891\n                                                </p>\n                                            </div>\n                                            <i class=\"ti ti-file-invoice icon hidden sm:block\" data-kid=\"1-2-1-2-1-2-1-1-3-2-1-3\" data-name=\"receipt invoice icon\" style=\"color:#52525B;width:18px;height:18px\">\n                                            </i>\n                                        </div>\n                                        <div class=\"receipt-drawer\" data-kid=\"1-2-1-2-1-2-1-1-3-2-2\" data-name=\"receipt detail drawer\" id=\"receipt-drawer\">\n                                            <div data-kid=\"1-2-1-2-1-2-1-1-3-2-2-1\">\n                                                <div class=\"grid gap-6 border-t border-[#E4E0D8] bg-[#FAF9F6] px-4 py-5 sm:grid-cols-[1fr_auto] sm:px-5\" data-kid=\"1-2-1-2-1-2-1-1-3-2-2-1-1\">\n                                                    <div data-kid=\"1-2-1-2-1-2-1-1-3-2-2-1-1-1\">\n                                                        <div class=\"flex items-center justify-between border-b border-[#E4E0D8] pb-3\" data-kid=\"1-2-1-2-1-2-1-1-3-2-2-1-1-1-1\">\n                                                            <p class=\"serif-display text-[21px] text-[#18181B]\" data-kid=\"1-2-1-2-1-2-1-1-3-2-2-1-1-1-1-1\">\n                                                                Lokka\n                                                            </p>\n                                                            <span class=\"text-[10px] font-semibold uppercase tracking-[0.15em] text-[#71717A]\" data-kid=\"1-2-1-2-1-2-1-1-3-2-2-1-1-1-1-2\">\n                                                  